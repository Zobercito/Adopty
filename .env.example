# Adopty — variables de entorno (nunca commitear valores reales).
# Copiar a .env para dev local. En Vercel: Settings → Environment Variables.

# Supabase (obligatorio)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
# El proyecto NO usa service role: la autorización real es RLS + RPC.
# No añadas SUPABASE_SERVICE_ROLE_KEY; si aparece, es un error de configuración.

# Dominio público: canonical, OG, sitemap y redirects de Auth.
# Local: http://localhost:4321 · Producción: https://adopty.lat
SITE_URL=http://localhost:4321

# OAuth Google (opcional en local; obligatorio en preview/prod para el botón Google)
# 1. Supabase Dashboard → Authentication → Providers → Google → ON (Client ID + Secret de Google Cloud).
# 2. Site URL + Redirects: http://localhost:4321 + https://<tu-preview>.vercel.app + /api/auth/callback
# En local con `supabase start`, las vars equivalents son:
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=tu-client-id
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=tu-secret
# Si no están configuradas, el botón de Google se oculta y /api/auth/google responde 404 (el correo sigue funcionando).
PUBLIC_GOOGLE_ENABLED=false

# Sentry (monitorización de errores). El DSN es público; definir ambos en Vercel.
# Sin valor, el SDK no se inicializa y la app funciona igual.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=

# Avisos de la app: la API key de Resend NO va en .env; vive en Supabase Vault
# como `resend_api_key` (ver docs/OPERACION.md, sección de avisos).

# Playwright. Sin E2E_BASE_URL se usa el dev server local en http://localhost:4321.
# E2E_BASE_URL=https://adopty.lat   # suite pública (solo lectura) contra un deploy
# E2E_FLUJO=1                       # flujo completo; ESCRIBE datos y solo vale con Supabase local
