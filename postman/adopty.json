{
  "info": {
    "name": "Adopty — API (Fase 7)",
    "description": "Colección QA de la API Adopty. Variables: baseUrl (local http://localhost:4321 o preview Vercel) y las claves demo/QA. Flujo sugerido: Auth → Mascotas → Solicitudes → Mensajes → Favoritos → Perfil y cuenta → Moderación → Reportes/verificación. Las rutas privadas usan la cookie de sesión que deja el Login (Postman la conserva); no hay bearer token porque el SSR autentica por cookies. Sustituye :id y <uuid> por valores reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4321" },
    { "key": "demo_password", "value": "" },
    { "key": "qa_password", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register persona",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"QA Test\",\"correo\":\"qa@adopty.pa\",\"password\":\"{{qa_password}}\",\"tipo_usuario\":\"persona\"}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"correo\":\"patitas@adopty.pa\",\"password\":\"{{demo_password}}\"}"
            }
          }
        },
        {
          "name": "Login rate-limit (repetir 11x → 429)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"correo\":\"x@x.pa\",\"password\":\"y\"}" }
          }
        },
        {
          "name": "Recuperar",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/recuperar",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"correo\":\"patitas@adopty.pa\"}" }
          }
        },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" } }
      ]
    },
    {
      "name": "Mascotas",
      "item": [
        {
          "name": "Buscar (filtros+orden+paginación)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/mascotas?especie=gato&tamano=Peque%C3%B1o&q=luna&orden=recientes&page=1"
          }
        },
        {
          "name": "Detalle",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/mascotas/:id" }
        },
        {
          "name": "Crear (requiere fotos[] de /upload)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/mascotas",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"Postman\",\"especie\":\"gato\",\"raza\":\"Criollo\",\"edad_meses\":6,\"sexo\":\"Hembra\",\"tamano\":\"Pequeño\",\"ubicacion\":\"Bethania\",\"descripcion\":\"Creada desde Postman para QA.\",\"estado_salud\":\"Sana\",\"fotos\":[\"<path-de-upload>\"],\"estado\":\"disponible\"}"
            }
          }
        },
        {
          "name": "Editar (PATCH parcial)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/mascotas/:id",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"descripcion\":\"Editada desde Postman para QA.\"}" }
          }
        },
        {
          "name": "Eliminar (soft-delete)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/mascotas/:id" }
        }
      ]
    },
    {
      "name": "Solicitudes",
      "item": [
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/solicitudes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"id_mascota\":\"<uuid>\",\"mensaje_inicial\":\"Quisiera adoptar, tengo casa con patio y experiencia.\"}"
            }
          }
        },
        {
          "name": "Crear duplicada (→ 409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/solicitudes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"id_mascota\":\"<uuid>\",\"mensaje_inicial\":\"Quisiera adoptar, tengo casa con patio y experiencia.\"}"
            }
          }
        },
        {
          "name": "Mis solicitudes",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/solicitudes?rol=adoptante" }
        },
        {
          "name": "Recibidas",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/solicitudes?rol=publicador" }
        },
        {
          "name": "Aprobar (publisher)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/solicitudes/:id",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"accion\":\"aprobar\"}" }
          }
        },
        {
          "name": "Rechazar (publisher)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/solicitudes/:id",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"accion\":\"rechazar\"}" }
          }
        },
        {
          "name": "Cancelar (adoptante)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/solicitudes/:id",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"accion\":\"cancelar\"}" }
          }
        }
      ]
    },
    {
      "name": "Mensajes",
      "item": [
        { "name": "Hilos", "request": { "method": "GET", "url": "{{baseUrl}}/api/mensajes" } },
        {
          "name": "Enviar (requiere aprobada)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/mensajes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"id_mascota\":\"<uuid>\",\"contenido\":\"Hola, ¿cuándo puedo conocerla?\"}"
            }
          }
        },
        {
          "name": "Marcar leído (receptor)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/mensajes/:id",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        }
      ]
    },
    {
      "name": "Favoritos y perfil",
      "item": [
        {
          "name": "Mis favoritos",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/favoritos" }
        },
        {
          "name": "Guardar favorito",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/favoritos",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"id_mascota\":\"<uuid>\"}" }
          }
        },
        {
          "name": "Quitar favorito",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/favoritos?id_mascota=<uuid>",
              "host": ["{{baseUrl}}"],
              "path": ["api", "favoritos"],
              "query": [{ "key": "id_mascota", "value": "<uuid>" }]
            }
          }
        }
      ]
    },
    {
      "name": "Perfil y cuenta",
      "item": [
        {
          "name": "Mi perfil (GET)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/perfil" }
        },
        {
          "name": "Preferencia de avisos por email",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/notificaciones",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"notificaciones_email\":true}" }
          }
        },
        {
          "name": "Actualizar perfil — persona (form-data)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/perfil",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nombre", "value": "QA Persona", "type": "text" },
                { "key": "descripcion", "value": "Perfil de prueba", "type": "text" },
                { "key": "experiencia", "value": "alguna_vez", "type": "text" },
                { "key": "motivacion", "value": "Quiero adoptar", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Actualizar perfil — organización (form-data)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/perfil",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nombre_oficial", "value": "Refugio QA", "type": "text" },
                { "key": "direccion", "value": "Ciudad de Panamá", "type": "text" },
                { "key": "descripcion", "value": "Refugio de prueba", "type": "text" },
                { "key": "sitio_web", "value": "https://example.org", "type": "text" },
                { "key": "contacto_visible", "value": "1", "type": "text" },
                { "key": "instagram", "value": "@refugioqa", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Mis datos (JSON)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/mis-datos" }
        },
        {
          "name": "Estilo de vida (GET)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/estilo-de-vida" }
        },
        {
          "name": "Estilo de vida (PUT)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/estilo-de-vida",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"ambiente\":\"apartamento\",\"ninos\":false,\"especie_pref\":\"perro\",\"ubicacion\":\"Bethania\",\"energia_pref\":\"moderada\",\"otras_mascotas\":false,\"edad_pref\":\"adulto\"}"
            }
          }
        },
        {
          "name": "Cambiar correo",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/auth/cambiar-email",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"correo\":\"nuevo-correo@adopty.pa\"}" }
          }
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/cambiar-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"actual\":\"{{demo_password}}\",\"nueva\":\"NuevaClave123!\",\"confirmar\":\"NuevaClave123!\"}"
            }
          }
        },
        {
          "name": "Baja de cuenta (irreversible)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cuenta/borrar",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"password\":\"{{demo_password}}\",\"confirmacion\":\"ELIMINAR\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Moderación (admin)",
      "item": [
        {
          "name": "Reportes pendientes (GET)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/reportes?estado=pendiente" }
        },
        {
          "name": "Resolver reporte (ocultar)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/reportes/:id",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"accion\":\"ocultar\",\"notas\":\"Revisado desde Postman\"}"
            }
          }
        },
        {
          "name": "Verificaciones pendientes (GET)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/verificaciones?estado=pendiente"
          }
        },
        {
          "name": "Resolver verificación (aprobar)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/verificaciones/:id",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"aprobar\":true,\"notas\":\"Evidencia válida\"}"
            }
          }
        },
        {
          "name": "Suspender/reactivar cuenta",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/admin/cuentas",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"id\":\"<uuid>\",\"activo\":false}" }
          }
        },
        {
          "name": "Restaurar publicación oculta",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/mascotas/:id/restaurar"
          }
        }
      ]
    },
    {
      "name": "Reportes, verificación y subida",
      "item": [
        {
          "name": "Reportar publicación",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/reportes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"id_mascota\":\"<uuid>\",\"motivo\":\"La publicación parece falsa o duplicada.\"}"
            }
          }
        },
        {
          "name": "Solicitar verificación (organización)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/verificacion",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"tipo_evidencia\":\"redes_sociales\",\"url_evidencia\":\"https://instagram.com/refugioqa\",\"descripcion\":\"Cuenta oficial del refugio\"}"
            }
          }
        },
        {
          "name": "Subir 1–5 fotos (form-data)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/mascotas/upload",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "fotos", "type": "file", "src": "/ruta/a/foto.jpg" }]
            }
          }
        }
      ]
    }
  ]
}
