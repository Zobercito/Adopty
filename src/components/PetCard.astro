---
import Badge from './Badge.astro';
import FavButton from './FavButton.astro';
import { estadoLabel, fotoUrl, gradFor, type FotoRow } from '../lib/mascotas';

interface Props {
  id: string;
  slug?: string;
  nombre: string;
  raza: string;
  sexo: string;
  tamano: string;
  ubicacion: string;
  estado: string;
  edadLabel: string;
  fotos?: FotoRow[];
  /** Etiqueta extra opcional (p. ej. "1 foto nueva") */
  eyebrow?: string;
  /** Breve descripción / personalidad (mockup) */
  descripcion?: string;
  /** Publicador (refugio o persona) */
  publicador?: string;
  /** Versión compacta (foto más baja y sin descripción) para encajar en la portada */
  compact?: boolean;
  /** % de afinidad con el perfil de estilo de vida (modo match) */
  afinidad?: number;
}
const {
  id,
  slug,
  nombre,
  raza,
  sexo,
  tamano,
  ubicacion,
  estado,
  edadLabel,
  fotos,
  eyebrow,
  descripcion,
  publicador,
  compact = false,
  afinidad,
} = Astro.props as Props;
const url = slug ? `/mascota/${slug}` : `/mascota/${id}`;
const principal = [...(fotos ?? [])].sort((a, b) => (a.es_principal === b.es_principal ? a.orden - b.orden : a.es_principal ? -1 : 1))[0];
const foto = fotoUrl(principal?.url_foto);
const grad = gradFor(id);
const extraFotos = (fotos?.length ?? 0) - (principal ? 1 : 0);
const etiqueta = [raza, edadLabel, sexo, tamano].filter(Boolean).join(' · ');
const fotoAlto = compact ? 'h-36' : 'h-56';
const cuerpo = compact ? 'p-4' : 'p-5';
const titulo = compact ? 'text-base' : 'text-xl';

const tags: { texto: string; clase: string }[] = [];
tags.push({ texto: tamano === 'Grande' ? 'Requiere patio' : 'Apto apartamento', clase: tamano === 'Grande' ? 'tag-warn' : 'tag-sky' });
if (sexo === 'Hembra') tags.push({ texto: 'Hembra', clase: 'tag-orange' });
else tags.push({ texto: 'Macho', clase: 'tag-neutral' });
---

<article class="soft-card overflow-hidden lift flex flex-col group h-full">
  <a href={url} aria-label={`Ver perfil de ${nombre}`} class="block relative">
    <div class={`pet-photo ${grad} w-full ${fotoAlto}`}>
      {
        foto && (
          <img
            src={foto}
            alt={`${nombre} - ${raza}`}
            loading="lazy"
            decoding="async"
            width="640"
            height="416"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            style="object-position:center"
            onerror="this.remove()"
          />
        )
      }
      {typeof afinidad === 'number' && (
        <span class="absolute top-3 left-3 inline-flex items-center gap-1 rounded-full bg-emerald-500 text-white text-xs font-extrabold px-2.5 py-1 shadow-md">
          ✦ {afinidad}% afinidad
        </span>
      )}
      <span
        class="absolute bottom-3 left-4 inline-flex items-center gap-1 bg-slate-900/60 backdrop-blur-md text-white text-xs font-semibold px-2.5 py-1 rounded-lg"
      >
        📍 {ubicacion}
      </span>
      {extraFotos > 0 && (
        <span class="absolute bottom-3 right-3 text-xs font-bold text-white bg-ink/70 backdrop-blur px-2.5 py-1 rounded-full">
          +{extraFotos} {extraFotos === 1 ? 'foto' : 'fotos'}
        </span>
      )}
    </div>
  </a>

  <div class={`${cuerpo} flex-1 flex flex-col justify-between`}>
    <div>
      <div class="flex items-center justify-between gap-2 mb-1">
        <h3 class={`font-display font-extrabold ${titulo} text-ink group-hover:text-brand transition-colors truncate`}>
          {nombre}
        </h3>
        <FavButton id={id} nombre={nombre} />
      </div>

      <p class="text-xs font-semibold text-muted">{etiqueta}</p>

      <div class="flex flex-wrap gap-1.5 mt-3">
        {tags.map((t) => <span class={`tag ${t.clase}`}>{t.texto}</span>)}
      </div>

      {
        !compact && (descripcion || eyebrow) && (
          <p class="text-xs text-body leading-relaxed mt-3 line-clamp-2">{descripcion ?? eyebrow}</p>
        )
      }
    </div>

    <div class="pt-3 mt-4 border-t border-line flex items-center justify-between gap-3">
      <span class="text-[11px] font-bold text-faint min-w-0 truncate">
        {publicador ? <>Por: <strong class="text-body">{publicador}</strong></> : <Badge estado={estadoLabel(estado)} />}
      </span>
      <a href={url} class="shrink-0 px-4 py-2 rounded-xl bg-teal-soft text-teal font-bold text-xs hover:bg-teal hover:text-white transition-colors">
        Ver compatibilidad
      </a>
    </div>
  </div>
</article>
