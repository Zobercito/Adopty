---
import Badge from './Badge.astro';
import type { Pet } from '../data/mockPets';
interface Props { pet: Pet; }
const { pet } = Astro.props as Props;
---
<article class="soft-card overflow-hidden">
  <a href={`/explorar?q=${pet.id}`} aria-label={`Ver perfil de ${pet.nombre}`}>
    <div class={`pet-photo ${pet.grad} w-full h-52`}>
      <img src={pet.foto} alt={`${pet.nombre} - ${pet.raza}`} loading="lazy" class="absolute inset-0 w-full h-full object-cover" style="object-position:center" onerror="this.remove()" />
    </div>
  </a>
  <div class="p-5">
    <div class="flex items-center justify-between">
      <Badge estado={pet.estado} />
      <span class="text-gray-300 text-xl" aria-hidden="true">♥</span>
    </div>
    <h3 class="font-display font-bold text-lg mt-2" style="color:#1E293B">{pet.nombre} <span class="text-sm font-medium text-gray-400">· {pet.raza}</span></h3>
    <p class="text-sm mt-1">{pet.edad} · {pet.sexo} · {pet.ubicacion}</p>
    <div class="flex gap-2 mt-4">
      <a href="/explorar" class="btn-primary text-sm px-5 py-2.5 flex-1 text-center">Ver perfil</a>
    </div>
  </div>
</article>
