---
/**
 * FavButton — ♥ con migración localStorage → DB (Fase 1) + delegación de eventos,
 * para que siga funcionando en cards inyectadas por JS (Fase 3, filtros client-side).
 */
interface Props { id: string; nombre: string; }
const { id, nombre } = Astro.props as Props;
---
<button
  type="button"
  data-fav-btn={id}
  aria-label={`Guardar ${nombre} en favoritos`}
  aria-pressed="false"
  title="Guardar en favoritos"
  class="text-gray-300 text-xl hover:scale-110 transition-transform"
>♥</button>
<script>
  // Delegación única a nivel documento: válida para todos los botones, presentes o futuros.
  type FavBtn = HTMLElement & { dataset: { favBtn: string } };
  const KEY = 'adopty_favs';
  const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const getLocal = (): string[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
  const setLocal = (f: string[]) => localStorage.setItem(KEY, JSON.stringify(f));
  const paint = (btn: FavBtn, on: boolean) => {
    btn.setAttribute('aria-pressed', String(on));
    btn.style.color = on ? '#FF7A29' : '';
  };
  // caché compartido: una sola petición de DB por página
  let dbPromise: Promise<string[]> | null = null;
  const dbFavs = (): Promise<string[]> => {
    if (!dbPromise) {
      dbPromise = fetch('/api/favoritos')
        .then((r) => (r.ok ? r.json() : { favoritos: [] }))
        .then((d) => (d.favoritos || []) as string[])
        .catch(() => []);
    }
    return dbPromise;
  };

  async function init(btn: FavBtn) {
    const id = btn.dataset.favBtn;
    if (UUID.test(id)) {
      const favoritos = await dbFavs();
      paint(btn, favoritos.includes(id) || getLocal().includes(id));
      // migración puntual de ids UUID locales → DB
      const pendientes = getLocal().filter((x) => UUID.test(x) && !favoritos.includes(x));
      for (const mid of pendientes) {
        await fetch('/api/favoritos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id_mascota: mid }),
        }).catch(() => {});
      }
      if (pendientes.length) setLocal(getLocal().filter((x) => !UUID.test(x)));
    } else {
      paint(btn, getLocal().includes(id));
    }
  }

  async function toggle(btn: FavBtn) {
    const id = btn.dataset.favBtn;
    const local = getLocal();
    const on = local.includes(id);
    if (!UUID.test(id)) {
      // catálogo demo (Fase 0): solo local
      setLocal(on ? local.filter((x) => x !== id) : [...local, id]);
      paint(btn, !on);
      return;
    }
    const res = on
      ? await fetch(`/api/favoritos?id_mascota=${id}`, { method: 'DELETE' })
      : await fetch('/api/favoritos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id_mascota: id }),
        });
    if (res.status === 401) {
      if (!on) setLocal([...local, id]); // intención guardada; retoma con ?next=
      location.href = `/login?next=${encodeURIComponent(location.pathname + location.search)}`;
      return;
    }
    if (res.ok) { paint(btn, !on); setLocal(local.filter((x) => x !== id)); }
  }

  if (!(window as unknown as Record<string, unknown>).__adoptyFav) {
    (window as unknown as Record<string, unknown>).__adoptyFav = true;
    document.addEventListener('click', (e) => {
      const t = (e.target as Element | null)?.closest?.('[data-fav-btn]') as FavBtn | null;
      if (t) void toggle(t);
    });
  }
  document.querySelectorAll<FavBtn>('[data-fav-btn]').forEach((b) => void init(b));
  // llamable desde scripts que inyectan cards (explorar Fase 3)
  (window as unknown as { adoptyFavInit?: (b: FavBtn) => void }).adoptyFavInit = init;
</script>
