---
/**
 * Navbar flotante rediseñada (mockup).
 * - Visitante: navegación de marketing (Inicio, Buscar mascotas, Cómo funciona,
 *   Sobre nosotros, Contacto) + Entrar / Regístrate.
 * - Con sesión: navegación de la app (Explorar, Favoritos, Mensajes, Solicitudes,
 *   Panel, Publicar) + avatar.
 * La pestaña activa se deriva de la URL, no de un prop.
 */
interface Props {
  active?: 'inicio' | 'explorar' | 'panel' | 'mensajes' | 'admin';
}
const { active } = Astro.props as Props;
const user = Astro.locals.user ?? null;
const isAdmin = Astro.locals.isAdmin === true;
const initial = (user?.email?.charAt(0) ?? 'A').toUpperCase();

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const claveDe = (p: string): string => {
  if (p === '/') return 'inicio';
  if (p.startsWith('/mascota/nueva')) return 'publicar';
  if (p.startsWith('/explorar') || p.startsWith('/mascota/')) return 'explorar';
  if (p.startsWith('/favoritos')) return 'favoritos';
  if (p.startsWith('/mensajes')) return 'mensajes';
  if (p.startsWith('/mis-solicitudes')) return 'mis-solicitudes';
  if (p.startsWith('/panel')) return 'panel';
  if (p.startsWith('/admin')) return 'admin';
  return active ?? '';
};
const current = claveDe(path);
// En la portada, el logo del navbar se oculta (en escritorio) porque el logo
// del hero "vuela" hasta ocupar exactamente ese hueco al hacer scroll.
const esInicio = path === '/';
// Datos calculados en el middleware: Panel solo para publicadores y punto de
// mensajes sin leer en la pestaña Mensajes.
const tienePublicaciones = Astro.locals.tienePublicaciones === true;
const sinLeer = Astro.locals.mensajesSinLeer ?? 0;

// Visitante (sin sesión): todas las opciones desplazan por la portada.
const enlacesVisitante = [
  { key: 'inicio', href: '/#inicio', label: 'Inicio' },
  { key: 'mascotas', href: '/#mascotas', label: 'Buscar mascotas' },
  { key: 'como-funciona', href: '/#como-funciona', label: 'Cómo funciona' },
  { key: 'nosotros', href: '/#nosotros', label: 'Sobre nosotros' },
  { key: 'contacto', href: '/#contacto', label: 'Contacto' },
];

// Con sesión: enlaces de la app. Sin "Inicio": el logo ya lleva a la portada de
// marketing, y el primer destino del menú es el espacio del usuario (Panel).
// "Panel" solo aparece si el usuario tiene publicaciones (para un adoptante es
// redundante: sus solicitudes, favoritos y mensajes ya viven en sus pestañas).
const enlacesApp = [
  ...(tienePublicaciones ? [{ key: 'panel', href: '/panel', label: 'Panel' }] : []),
  { key: 'explorar', href: '/explorar', label: 'Explorar' },
  { key: 'favoritos', href: '/favoritos', label: 'Favoritos' },
  { key: 'mensajes', href: '/mensajes', label: 'Mensajes' },
  { key: 'mis-solicitudes', href: '/mis-solicitudes', label: 'Solicitudes' },
  { key: 'publicar', href: '/mascota/nueva', label: 'Publicar' },
];
const visibles = (user ? enlacesApp : enlacesVisitante) as { key: string; href: string; label: string }[];
---

<div class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-100">
  <nav
    class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between gap-3"
    aria-label="Navegación principal"
  >
    <span class="nav-brand-slot">
      <a
        id="navBrand"
        href="/"
        class:list={['nav-brand flex items-center gap-2.5 shrink-0 group', esInicio && 'nav-brand--home']}
        aria-label="Adopty, ir al inicio"
      >
        <img
          src="/brand/adopty-logo-icon-sm.png"
          alt=""
          width="376"
          height="300"
          class="h-10 w-auto shrink-0 transition-transform group-hover:scale-105"
        />
        <img
          src="/brand/adopty-logo-text-sm.png"
          alt="Adopty"
          width="642"
          height="180"
          class="h-7 w-auto"
        />
      </a>
    </span>

    <ul class="hidden lg:flex items-center gap-7 text-sm font-semibold list-none m-0 p-0">
      {
        visibles.map((e) => (
          <li>
            <a
              href={e.href}
              class="nav-link"
              aria-current={current === e.key ? 'page' : undefined}
            >
              {e.label}
              {e.key === 'mensajes' && sinLeer > 0 && (
                <>
                  <span
                    class="ml-1 inline-block w-2 h-2 rounded-full bg-brand align-middle"
                    aria-hidden="true"
                  />
                  <span class="sr-only">{sinLeer} sin leer</span>
                </>
              )}
            </a>
          </li>
        ))
      }
      {
        isAdmin && (
          <li>
            <a href="/admin" class="nav-link" aria-current={current === 'admin' ? 'page' : undefined}>
              Admin
            </a>
          </li>
        )
      }
    </ul>

    <div class="flex items-center gap-2 shrink-0">
      {
        user ? (
          <a
            href="/perfil"
            class="avatar w-10 h-10 text-sm"
            aria-label={`Mi perfil (${initial})`}
            title={user.email ?? 'Mi perfil'}
          >
            {initial}
          </a>
        ) : (
          <>
            <a href="/login" class="hidden sm:inline-block px-4 py-2.5 rounded-2xl font-bold text-sm text-teal hover:bg-teal-soft transition-colors">
              Iniciar sesión
            </a>
            <a href="/register?tipo=persona" class="hidden sm:inline-block btn-primary text-sm px-5 py-2.5">
              Regístrate
            </a>
          </>
        )
      }
      {user && (
        <a href="/explorar" class="btn-primary text-sm px-5 py-2.5 hidden sm:inline-block">
          Adoptar
        </a>
      )}
      {/* Menú colapsable: los enlaces en línea solo caben a partir de lg (~880px) */}
      <button
        type="button"
        id="navToggle"
        class="nav-burger lg:hidden w-11 h-11 rounded-2xl flex items-center justify-center border-2 border-line bg-white"
        aria-expanded="false"
        aria-controls="navMovil"
        aria-label="Abrir menú"
      >
        <span class="sr-only">Menú</span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" class="nav-icon-open"></path>
          <path d="M6 6l12 12M18 6L6 18" class="nav-icon-close" hidden></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menú móvil -->
  <div id="navMovil" class="lg:hidden bg-white border-t border-slate-100 px-4 py-4 hidden">
    <ul class="list-none m-0 p-0 grid grid-cols-2 gap-1.5">
      {
        visibles.map((e) => (
          <li>
            <a
              href={e.href}
              class="nav-movil-link"
              aria-current={current === e.key ? 'page' : undefined}
            >
              {e.label}
              {e.key === 'mensajes' && sinLeer > 0 && (
                <>
                  <span
                    class="ml-1 inline-block w-2 h-2 rounded-full bg-brand align-middle"
                    aria-hidden="true"
                  />
                  <span class="sr-only">{sinLeer} sin leer</span>
                </>
              )}
            </a>
          </li>
        ))
      }
      {
        user && (
          <li>
            <a href="/perfil" class="nav-movil-link">
              Mi perfil
            </a>
          </li>
        )
      }
      {
        isAdmin && (
          <li>
            <a
              href="/admin"
              class="nav-movil-link"
              aria-current={current === 'admin' ? 'page' : undefined}
            >
              Admin
            </a>
          </li>
        )
      }
    </ul>

    <div class="mt-3 pt-3 border-t border-slate-100 flex flex-col gap-2">
      {
        user ? (
          <form action="/api/auth/logout" method="post">
            <button type="submit" class="btn-ghost w-full text-sm py-2.5">
              Cerrar sesión
            </button>
          </form>
        ) : (
          <>
            <a href="/login" class="w-full text-center py-2.5 rounded-2xl font-bold text-sm text-teal bg-teal-soft">
              Iniciar sesión
            </a>
            <a href="/register?tipo=persona" class="btn-primary w-full text-sm py-2.5">Regístrate</a>
          </>
        )
      }
    </div>
  </div>
</div>

<style>
  /* Logo del navbar. En la portada (clase --home) arranca oculto y sube desde
     abajo cuando se hace scroll; fuera de la portada se ve normal. */
  .nav-brand-slot {
    display: inline-flex;
    overflow: hidden;
  }
  .nav-brand {
    transition:
      transform 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s ease;
  }
  .nav-brand--home {
    transform: translateY(120%);
    opacity: 0;
  }
  .nav-brand--home.nav-brand--visible {
    transform: translateY(0);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-brand {
      transition: none;
    }
  }

  /* Icono hamburguesa ↔ X */
  .nav-burger {
    color: #1e293b;
  }
  .nav-burger:hover {
    border-color: #00a8e8;
    color: #0090c7;
  }

  /* Enlaces del panel móvil */
  .nav-movil-link {
    display: block;
    border-radius: 1rem;
    padding: 0.7rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #475569;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .nav-movil-link:hover {
    background: #f8fafc;
    color: #1e293b;
  }
  .nav-movil-link[aria-current='page'] {
    background: #fff0ea;
    color: #e85a24;
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const panel = document.getElementById('navMovil');
  if (toggle && panel) {
    const iconOpen = toggle.querySelector('.nav-icon-open');
    const iconClose = toggle.querySelector('.nav-icon-close');
    const setAbierto = (abierto: boolean) => {
      panel.classList.toggle('hidden', !abierto);
      toggle.setAttribute('aria-expanded', String(abierto));
      toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
      // El intercambio hamburguesa↔X va por el atributo `hidden`: el preflight
      // de Tailwind lo aplica con !important y gana a cualquier regla CSS.
      if (iconOpen) iconOpen.toggleAttribute('hidden', abierto);
      if (iconClose) iconClose.toggleAttribute('hidden', !abierto);
    };
    toggle.addEventListener('click', () => setAbierto(toggle.getAttribute('aria-expanded') !== 'true'));
    // Cerrar con Escape o al hacer clic fuera
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setAbierto(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      const t = e.target as Node;
      if (!panel.contains(t) && !toggle.contains(t)) setAbierto(false);
    });
    // En móvil, al tocar un enlace (aunque sea un ancla interna) se cierra el menú.
    panel.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setAbierto(false);
    });
  }
</script>
