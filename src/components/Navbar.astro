---
interface Props { active?: 'inicio' | 'explorar' | 'panel' | 'mensajes'; }
const { active = 'inicio' } = Astro.props as Props;
const user = Astro.locals.user ?? null;
const initial = (user?.email?.charAt(0) ?? 'A').toUpperCase();
const link = (key: string, href: string, label: string) =>
  active === key
    ? `<a href="${href}" style="color:#FF7A29">${label}</a>`
    : `<a href="${href}" class="hover:opacity-70">${label}</a>`;
---
<div class="max-w-6xl mx-auto px-4 pt-4 sticky top-3 z-50">
  <nav class="nav-float flex items-center justify-between px-4 sm:px-6 py-3" aria-label="Navegación principal">
    <a href="/" class="flex items-center gap-2" aria-label="Adopty inicio">
      <img src="/assets/logo.svg" class="w-9 h-9" alt="Logo Adopty" />
      <span class="font-display font-extrabold text-xl" style="color:#1E293B">Ad<span style="color:#FF7A29">o</span>pty<span style="color:#2EC4B6">.</span></span>
    </a>
    <div class="hidden md:flex items-center gap-7 text-sm font-semibold" style="color:#475569">
      <Fragment set:html={link('inicio', '/', 'Inicio')} />
      <Fragment set:html={link('explorar', '/explorar', 'Explorar')} />
{user ? (
        <Fragment set:html={link('explorar', '/favoritos', 'Favoritos')} />
      ) : (
        <span class="opacity-50" title="Entra para ver tus favoritos">Favoritos</span>
      )}
      {user ? (
        <Fragment set:html={link('mensajes', '/mensajes', 'Mensajes')} />
      ) : (
        <span class="opacity-50" title="Entra para ver tus mensajes">Mensajes</span>
      )}
      {user && <a href="/mascota/nueva" class="hover:opacity-70">Publicar</a>}
      {user && <a href="/mis-solicitudes" class="hover:opacity-70">Solicitudes</a>}
      <span class="opacity-50" title="Fase 6">Panel</span>
    </div>
    <div class="flex items-center gap-3">
      {user ? (
        <a href="/perfil" aria-label="Mi perfil" class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-white" style="background:#2EC4B6">{initial}</a>
      ) : (
        <a href="/login" class="btn-ghost text-sm px-5 py-2">Entrar</a>
      )}
      <a href="/explorar" class="btn-primary text-sm px-5 py-2.5 hidden sm:inline-block">Adoptar</a>
    </div>
  </nav>
</div>
