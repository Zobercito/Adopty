---
/**
 * Navbar flotante. La pestaña activa se deriva de la URL (no del prop `active`),
 * así que "Publicar" y "Solicitudes" también pueden marcarse.
 */
interface Props {
  active?: 'inicio' | 'explorar' | 'panel' | 'mensajes' | 'admin';
}
const { active } = Astro.props as Props;
const user = Astro.locals.user ?? null;
const isAdmin = Astro.locals.isAdmin === true;
const initial = (user?.email?.charAt(0) ?? 'A').toUpperCase();

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const claveDe = (p: string): string => {
  if (p === '/') return 'inicio';
  if (p.startsWith('/explorar') || p.startsWith('/mascota/')) return 'explorar';
  if (p.startsWith('/favoritos')) return 'favoritos';
  if (p.startsWith('/mensajes')) return 'mensajes';
  if (p.startsWith('/mis-solicitudes')) return 'mis-solicitudes';
  if (p.startsWith('/panel')) return 'panel';
  if (p.startsWith('/mascota/nueva')) return 'publicar';
  if (p.startsWith('/admin')) return 'admin';
  return active ?? '';
};
const current = claveDe(path);

// Enlaces visitors: se ocultan si no hay sesión (antes se mostraban "deshabilitados").
const enlaces = [
  { key: 'inicio', href: '/', label: 'Inicio' },
  { key: 'explorar', href: '/explorar', label: 'Explorar' },
  { key: 'favoritos', href: '/favoritos', label: 'Favoritos', auth: true },
  { key: 'mensajes', href: '/mensajes', label: 'Mensajes', auth: true },
  { key: 'mis-solicitudes', href: '/mis-solicitudes', label: 'Solicitudes', auth: true },
  { key: 'panel', href: '/panel', label: 'Panel', auth: true },
  { key: 'publicar', href: '/mascota/nueva', label: 'Publicar', auth: true },
];
const visibles = enlaces.filter((e) => !e.auth || user);
---

<div class="max-w-6xl mx-auto px-3 sm:px-4 pt-4 sticky top-3 z-50">
  <nav class="nav-float flex items-center justify-between gap-2 sm:gap-3 px-3 sm:px-6 py-2.5 sm:py-3" aria-label="Navegación principal">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Adopty, ir al inicio">
      <img src="/assets/logo.svg" class="w-9 h-9" alt="" width="36" height="36" />
      <span class="font-display font-extrabold text-xl text-ink whitespace-nowrap"
        >Ad<span class="text-brand">o</span>pty<span class="text-teal">.</span></span
      >
    </a>

    <ul class="hidden lg:flex items-center gap-6 xl:gap-7 text-sm font-semibold list-none m-0 p-0">
      {
        visibles.map((e) => (
          <li>
            <a
              href={e.href}
              class="nav-link"
              aria-current={current === e.key ? 'page' : undefined}
            >
              {e.label}
            </a>
          </li>
        ))
      }
      {
        isAdmin && (
          <li>
            <span class="text-faint" aria-hidden="true">
              ·
            </span>
          </li>
        )
      }
      {
        isAdmin && (
          <li>
            <a href="/admin" class="nav-link" aria-current={current === 'admin' ? 'page' : undefined}>
              Admin
            </a>
          </li>
        )
      }
    </ul>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      {
        user ? (
          <a
            href="/perfil"
            class="avatar w-9 h-9 text-sm"
            aria-label={`Mi perfil (${initial})`}
            title={user.email ?? 'Mi perfil'}
          >
            {initial}
          </a>
        ) : (
          <a href="/login" class="btn-ghost text-sm px-4 sm:px-5 py-2">
            Entrar
          </a>
        )
      }
      {/* En móvil el CTA vive en el menú desplegable: aquí solo estorba al ancho */}
      <a href="/explorar" class="btn-primary text-sm px-5 py-2.5 hidden sm:inline-block">
        Adoptar
      </a>

      {/* Menú colapsable: los enlaces en línea solo caben a partir de lg (~880px) */}
      <button
        type="button"
        id="navToggle"
        class="nav-burger lg:hidden w-10 h-10 rounded-full flex items-center justify-center border-2 border-line bg-white"
        aria-expanded="false"
        aria-controls="navMovil"
        aria-label="Abrir menú"
      >
        <span class="sr-only">Menú</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" class="nav-icon-open"></path>
          <path d="M6 6l12 12M18 6L6 18" class="nav-icon-close" hidden></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="navMovil"
    class="nav-float lg:hidden mt-2 p-2 hidden"
    style="border-radius:1.5rem"
  >
    <ul class="list-none m-0 p-0 grid grid-cols-2 gap-1">
      {
        visibles.map((e) => (
          <li>
            <a
              href={e.href}
              class="nav-movil-link"
              aria-current={current === e.key ? 'page' : undefined}
            >
              {e.label}
            </a>
          </li>
        ))
      }
      {
        user && (
          <li>
            <a href="/perfil" class="nav-movil-link">
              Mi perfil
            </a>
          </li>
        )
      }
      {
        isAdmin && (
          <li>
            <a
              href="/admin"
              class="nav-movil-link"
              aria-current={current === 'admin' ? 'page' : undefined}
            >
              Admin
            </a>
          </li>
        )
      }
    </ul>
    {
      user && (
        <form action="/api/auth/logout" method="post" class="mt-2 pt-2 border-t border-line">
          <button type="submit" class="btn-ghost w-full text-sm py-2.5">
            Cerrar sesión
          </button>
        </form>
      )
    }
  </div>
</div>

<style>
  /* Icono hamburguesa ↔ X */
  .nav-burger {
    color: #1e293b;
  }
  .nav-burger:hover {
    border-color: #2ec4b6;
    color: #14a098;
  }

  /* Enlaces del panel móvil */
  .nav-movil-link {
    display: block;
    border-radius: 1rem;
    padding: 0.7rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #475569;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .nav-movil-link:hover {
    background: #f8fafc;
    color: #1e293b;
  }
  .nav-movil-link[aria-current='page'] {
    background: #fff1e6;
    color: #f2670c;
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const panel = document.getElementById('navMovil');
  if (toggle && panel) {
    const iconOpen = toggle.querySelector('.nav-icon-open');
    const iconClose = toggle.querySelector('.nav-icon-close');
    const setAbierto = (abierto: boolean) => {
      panel.classList.toggle('hidden', !abierto);
      toggle.setAttribute('aria-expanded', String(abierto));
      toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
      // El intercambio hamburguesa↔X va por el atributo `hidden`: el preflight
      // de Tailwind lo aplica con !important y gana a cualquier regla CSS.
      if (iconOpen) iconOpen.toggleAttribute('hidden', abierto);
      if (iconClose) iconClose.toggleAttribute('hidden', !abierto);
    };
    toggle.addEventListener('click', () => setAbierto(toggle.getAttribute('aria-expanded') !== 'true'));
    // Cerrar con Escape o al hacer clic fuera
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setAbierto(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      const t = e.target as Node;
      if (!panel.contains(t) && !toggle.contains(t)) setAbierto(false);
    });
  }
</script>