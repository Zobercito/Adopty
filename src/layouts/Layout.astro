---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = 'Adopty — Adopta con amor en Panamá',
  description = 'Plataforma centralizada de adopción de mascotas en Panamá: busca, chatee y solicita sin exponer tu número.',
  ogImage,
} = Astro.props as Props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PA" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <!-- Instalable como app: iOS no lee el manifest, necesita estos links -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="167x167" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Adopty" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#FF7A29" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <!-- Envoltorio enfocable: da destino real al skip-link sin tocar cada <main> -->
    <div id="contenido" tabindex="-1" class="focus:outline-none">
      <slot />
    </div>
    <footer class="max-w-6xl mx-auto px-4 my-10">
      <div class="soft-card p-6 flex flex-col sm:flex-row justify-between gap-3 text-sm">
        <p><b class="text-ink">Adopty</b> · Ing. Software II · Francisco Gonzalez · Eira Arrocha</p>
        <p class="flex flex-wrap gap-x-3 gap-y-0">
          <a href="/terminos" class="link link-suave">Términos</a>
          <a href="/privacidad" class="link link-suave">Privacidad</a>
          <span class="text-faint self-center text-xs">Astro · Supabase · Vercel</span>
        </p>
      </div>
    </footer>
    <Analytics />
    <script>
      import { trackEvento } from '../lib/analytics';
      // Expone el tracker para los scripts inline (define:vars) que no pueden importar.
      window.adoptyTrack = trackEvento;
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>

<style>
  /* Los <main> de cada página no share id: se lo damos aquí para el skip-link. */
  :global(main) {
    scroll-margin-top: 6rem;
  }
</style>