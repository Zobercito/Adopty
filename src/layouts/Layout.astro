---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = 'Adopty — Adopta con amor en Panamá',
  description = 'Plataforma centralizada de adopción de mascotas en Panamá: busca, chatee y solicita sin exponer tu número.',
  ogImage,
} = Astro.props as Props;

const user = Astro.locals.user ?? null;
const anio = new Date().getFullYear();
// Portada tipo "pantalla completa": activa el scroll por secciones solo en inicio.
const esInicio = (Astro.url.pathname.replace(/\/+$/, '') || '/') === '/';
---

<!DOCTYPE html>
<html lang="es" class:list={[esInicio && 'snap-home']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PA" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <!-- Instalable como app: iOS no lee el manifest, necesita estos links -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="167x167" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Adopty" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#FF6B35" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <!-- Envoltorio enfocable: da destino real al skip-link sin tocar cada <main> -->
    <div id="contenido" tabindex="-1" class="focus:outline-none">
      <slot />

      <!-- Pie de página (rediseño mockup) -->
      <footer id="contacto" class="bg-slate-900 text-slate-300 mt-16">
      <div class="max-w-6xl mx-auto px-4 pt-10 pb-10">
        {
          esInicio && (
            <div
              class="rounded-[2rem] p-8 sm:p-10 text-center text-white relative overflow-hidden mb-10"
              style="background:linear-gradient(120deg,#FF6B35,#00A8E8)"
            >
              <h2 class="font-display font-extrabold text-2xl sm:text-3xl">
                ¿Listo para conocer a tu nuevo mejor amigo?
              </h2>
              <p class="text-white/90 text-sm sm:text-base mt-3 max-w-xl mx-auto">
                Regístrate y descubre a tu nuevo mejor amigo hoy mismo.
              </p>
              <div class="flex flex-col sm:flex-row gap-3 justify-center mt-6">
                <a
                  href="/login"
                  class="px-8 py-3.5 rounded-2xl bg-white text-brand font-bold text-sm hover:bg-slate-50 transition-colors"
                >
                  Iniciar sesión
                </a>
                <a
                  href="/register?tipo=persona"
                  class="px-8 py-3.5 rounded-2xl bg-slate-900/25 text-white font-bold text-sm border border-white/40 hover:bg-slate-900/40 transition-colors"
                >
                  Crear cuenta gratis
                </a>
              </div>
            </div>
          )
        }
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-10 border-b border-slate-800">
          <div class="space-y-4">
            <p class="text-slate-400 text-xs leading-relaxed">
              Plataforma centralizada e inteligente para la adopción de mascotas en Panamá. Reducimos el
              abandono y promovemos el bienestar animal.
            </p>
          </div>

          <div>
            <h2 class="text-white font-extrabold text-sm mb-4">Navegación</h2>
            <ul class="space-y-2.5 text-xs text-slate-400 font-medium list-none p-0 m-0">
              {!user && <li><a href="/" class="link-suave">Inicio</a></li>}
              <li>
                <a href={user ? '/explorar' : '/#mascotas'} class="link-suave">Buscar mascotas</a>
              </li>
              <li><a href="/#como-funciona" class="link-suave">Cómo funciona</a></li>
              {!user && <li><a href="/#nosotros" class="link-suave">Sobre nosotros</a></li>}
            </ul>
          </div>

          <div>
            <h2 class="text-white font-extrabold text-sm mb-4">Proyecto académico</h2>
            <ul class="space-y-2 text-xs text-slate-400 font-medium list-none p-0 m-0">
              <li><strong class="text-slate-300">Universidad de Panamá</strong></li>
              <li>Facultad de Informática, Electrónica y Comunicación</li>
              <li class="pt-1 text-slate-500">Materia: Ingeniería de Software II</li>
              <li class="text-slate-500">Francisco Gonzalez · Eira Arrocha</li>
            </ul>
          </div>

          <div>
            <h2 class="text-white font-extrabold text-sm mb-4">
              {user ? 'Sigue ayudando' : 'Únete como refugio'}
            </h2>
            <p class="text-xs text-slate-400 mb-3">
              {user
                ? 'Publica una mascota o revisa tus solicitudes pendientes.'
                : '¿Tienes una fundación o eres rescatista independiente?'}
            </p>
            <a
              href={user ? '/mascota/nueva' : '/register?tipo=organizacion'}
              class="block text-center w-full py-3 rounded-2xl bg-teal hover:bg-teal-dark text-white font-bold text-xs transition-colors"
            >
              {user ? 'Publicar mascota' : 'Registrar mi organización'}
            </a>
          </div>
        </div>

        <div
          class="pt-8 text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-3"
        >
          <p>© {anio} Adopty Panamá. Todos los derechos reservados.</p>
          <p class="flex flex-wrap items-center gap-x-4 gap-y-1 justify-center">
            <a href="/terminos" class="link-suave">Términos</a>
            <a href="/privacidad" class="link-suave">Privacidad</a>
            <span class="text-slate-600">Diseñado con amor para salvar vidas 🐾</span>
          </p>
        </div>
      </div>
    </footer>
    </div>

    <Analytics />
    <script>
      import { trackEvento } from '../lib/analytics';
      // Expone el tracker para los scripts inline (define:vars) que no pueden importar.
      window.adoptyTrack = trackEvento;
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>

<style>
  /* Los <main> de cada página no share id: se lo damos aquí para el skip-link. */
  :global(main) {
    scroll-margin-top: 6rem;
  }
  /* Enlaces del pie oscuro */
  footer .link-suave {
    color: #94a3b8;
  }
  footer .link-suave:hover {
    color: #fff;
  }
</style>
