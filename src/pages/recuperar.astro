---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Adopty — Recuperar contraseña">
  <Navbar />
  <main class="max-w-md mx-auto px-4 mt-8">
    <div class="soft-card p-7 sm:p-8">
      <h1 class="font-display font-extrabold text-2xl">Recuperar contraseña</h1>
      <p class="text-sm mt-1 text-muted">Te enviamos un enlace para restablecerla.</p>

      <p id="err" class="alert alert-error mt-4 hidden" role="alert" />
      <p id="ok" class="alert alert-ok mt-4 hidden" role="status" />

      <form id="recForm" class="mt-5 grid gap-4">
        <div>
          <label class="label" for="correo">Correo</label>
          <input
            id="correo"
            name="correo"
            type="email"
            required
            autocomplete="email"
            autocapitalize="none"
            spellcheck="false"
            class="input-soft mt-1 text-sm"
          />
        </div>
        <button id="recBtn" class="btn-primary py-3 text-sm" type="submit">Enviar enlace</button>
      </form>

      <p class="text-sm mt-5 text-center">
        <a href="/login" class="link-suave">Volver a entrar</a>
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById('recForm');
    const err = document.getElementById('err');
    const ok = document.getElementById('ok');
    const btn = document.getElementById('recBtn');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      ok.classList.add('hidden');
      if (!form.reportValidity()) return;
      const fd = new FormData(form);
      btn.disabled = true;
      btn.textContent = 'Enviando…';
      try {
        const res = await fetch('/api/auth/recuperar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ correo: fd.get('correo') }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          err.textContent = data.error ?? 'Error al enviar';
          err.classList.remove('hidden');
          return;
        }
        ok.textContent = 'Si el correo existe, recibirás el enlace en unos minutos.';
        ok.classList.remove('hidden');
        form.reset();
      } catch {
        err.textContent = 'No se pudo conectar. Revisa tu red e intenta de nuevo.';
        err.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Enviar enlace';
      }
    });
  </script>
</Layout>