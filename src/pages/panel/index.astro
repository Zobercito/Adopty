---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Badge from '../../components/Badge.astro';
import { supabaseServer } from '../../lib/supabase';
import { estadoLabel } from '../../lib/mascotas';
import { fechaCorta } from '../../lib/solicitudes';
import { getPanelResumen } from '../../lib/panel';

if (!Astro.locals.user) return Astro.redirect('/login?next=/panel');
// El panel es solo para publicadores: sin publicaciones no aporta nada, así que
// se manda al adoptante a sus solicitudes (lo demás vive en sus pestañas).
if (!Astro.locals.tienePublicaciones) return Astro.redirect('/mis-solicitudes');
const supabase = supabaseServer(Astro.cookies);
let resumen: Awaited<ReturnType<typeof getPanelResumen>> | null = null;
let errorMsg = '';
try {
  resumen = await getPanelResumen(supabase, Astro.locals.user.id);
} catch (e) {
  errorMsg = e instanceof Error ? e.message : 'Error al cargar';
}
const stats = resumen
  ? [
      { n: resumen.publicadas, label: 'Publicadas', href: null },
      { n: resumen.pendientes, label: 'Solicitudes pendientes', href: '/panel/solicitudes' },
      { n: resumen.noLeidos, label: 'Mensajes no leídos', href: '/mensajes' },
      { n: resumen.interesados, label: 'Interesados', href: null },
    ]
  : [];
---

<Layout title="Adopty — Mi panel de publicador">
  <Navbar />
  <main class="max-w-6xl mx-auto px-4 mt-6">
    <div class="flex items-start justify-between flex-wrap gap-3">
      <div>
        <h1 class="font-display font-extrabold text-2xl">Mi panel</h1>
        <p class="text-sm mt-1 text-muted">Gestiona tus publicaciones, solicitudes y mensajes.</p>
      </div>
      <div class="flex gap-2">
        <a href="/panel/solicitudes" class="btn-ghost text-sm px-5 py-2.5">Solicitudes</a>
        <a href="/mascota/nueva" class="btn-primary text-sm px-5 py-2.5">+ Publicar</a>
      </div>
    </div>

    {errorMsg && <p class="alert alert-error mt-5" role="alert">{errorMsg}</p>}

    {
      resumen && (
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-5" role="status" aria-label="Resumen">
          {stats.map((s) => {
            const Tag = s.href ? 'a' : 'div';
            return (
              <Tag
                href={s.href ?? undefined}
                class={`soft-card p-5 text-center ${s.href ? 'card-link' : ''}`}
              >
                <p class="font-display font-extrabold text-3xl text-ink tabular">{s.n}</p>
                <p class="text-xs mt-1 text-muted">{s.label}</p>
              </Tag>
            );
          })}
        </div>
      )
    }

    {
      resumen && !errorMsg && resumen.mascotas.length === 0 ? (
        <div class="soft-card p-10 mt-6 text-center">
          <p class="text-5xl" aria-hidden="true">🐾</p>
          <h2 class="font-display font-extrabold text-xl mt-4">Publica tu primera mascota</h2>
          <p class="text-sm mt-2 text-muted">Cuéntanos quién busca hogar y encuentrales un hogar.</p>
          <a href="/mascota/nueva" class="btn-primary text-sm px-6 py-2.5 mt-5">Publicar mascota</a>
        </div>
      ) : (
        <div class="grid gap-4 mt-6">
          {(resumen?.mascotas ?? []).map((p) => (
            <article class="soft-card p-4 sm:p-5 flex flex-col sm:flex-row gap-4">
              <a
                href={`/mascota/${p.id}`}
                class="shrink-0 w-full sm:w-28 h-40 sm:h-28 rounded-xl overflow-hidden bg-surface relative block"
                aria-label={`Ver ${p.nombre}`}
              >
                {p.foto && (
                  <img
                    src={p.foto}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="112"
                    height="112"
                    class="absolute inset-0 w-full h-full object-cover"
                    onerror="this.remove()"
                  />
                )}
              </a>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <a href={`/mascota/${p.id}`} class="font-display font-bold text-lg text-ink">
                    {p.nombre}
                  </a>
                  <Badge estado={estadoLabel(p.estado)} />
                  <span class="text-xs text-faint ml-auto tabular">
                    {fechaCorta(p.fecha_publicacion)}
                  </span>
                </div>
                <p class="text-xs mt-1 text-muted">{p.raza}</p>

                <ul class="flex flex-wrap gap-2 mt-3 text-xs">
                  <li>
                    <a href="/panel/solicitudes" class="badge badge-proceso hover:opacity-80">
                      {p.solicitudes} {p.solicitudes === 1 ? 'solicitud' : 'solicitudes'}
                    </a>
                  </li>
                  {p.pendientes > 0 && (
                    <li>
                      <a href="/panel/solicitudes" class="badge badge-adoptada hover:opacity-80">
                        {p.pendientes} pendientes
                      </a>
                    </li>
                  )}
                  {p.noLeidos > 0 && (
                    <li>
                      <a href="/mensajes" class="badge badge-disponible hover:opacity-80">
                        {p.noLeidos} sin leer
                      </a>
                    </li>
                  )}
                  {p.interesados > 0 && <li class="badge badge-adoptada">{p.interesados} interesados</li>}
                </ul>

                <div class="flex flex-wrap items-center gap-2 mt-4 pt-3 border-t border-line">
                  <a href={`/mascota/${p.id}/editar`} class="btn-ghost text-xs px-4 py-2">
                    Editar
                  </a>
                  <label class="label" for={`estado-${p.id}`}>
                    Estado
                  </label>
                  <select
                    id={`estado-${p.id}`}
                    data-estado={p.id}
                    class="input-soft text-xs py-2 w-auto"
                    aria-label={`Estado de ${p.nombre}`}
                  >
                    <option value="disponible" selected={p.estado === 'disponible'}>
                      Disponible
                    </option>
                    <option value="en_proceso" selected={p.estado === 'en_proceso'}>
                      En proceso
                    </option>
                    <option value="adoptada" selected={p.estado === 'adoptada'}>Adoptada</option>
                  </select>
                  <button
                    type="button"
                    data-eliminar={p.id}
                    data-nombre={p.nombre}
                    class="btn-quiet text-xs px-3 py-2 ml-auto text-danger"
                  >
                    Eliminar
                  </button>
                </div>
                <p data-err={p.id} class="alert alert-error text-xs mt-2 hidden" role="alert" />
              </div>
            </article>
          ))}
        </div>
      )
    }
  </main>

  <script>
    document.querySelectorAll('[data-estado]').forEach((sel) =>
      sel.addEventListener('change', async () => {
        const id = sel.getAttribute('data-estado');
        const err = document.querySelector(`[data-err="${id}"]`);
        err.classList.add('hidden');
        sel.disabled = true;
        const res = await fetch(`/api/mascotas/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ estado: sel.value }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          err.textContent = data.error || 'No se pudo cambiar el estado';
          err.classList.remove('hidden');
          sel.disabled = false;
          return;
        }
        location.reload();
      }),
    );
    document.querySelectorAll('[data-eliminar]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        if (!confirm(`¿Eliminar la publicación de ${btn.getAttribute('data-nombre')}? Se oculta de Explorar.`))
          return;
        btn.disabled = true;
        btn.textContent = 'Eliminando…';
        const res = await fetch(`/api/mascotas/${btn.getAttribute('data-eliminar')}`, {
          method: 'DELETE',
        });
        if (res.ok) {
          location.reload();
        } else {
          btn.disabled = false;
          btn.textContent = 'Eliminar';
          alert('No se pudo eliminar');
        }
      }),
    );
  </script>
</Layout>