---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const SECCIONES = [
  {
    t: '1. Qué datos guardamos',
    p: 'Correo y tipo de cuenta; nombre y descripción de perfil; teléfono solo si lo escribes (nunca se muestra en público); ubicación que publicas en cada mascota; fotos; mensajes y solicitudes que intercambias.',
  },
  {
    t: '2. Para qué los usamos',
    p: 'Operar la plataforma: autenticarte, mostrar tus publicaciones, permitir solicitudes y chat entre adoptantes y publicadores. No vendemos datos ni hacemos publicidad con ellos.',
  },
  {
    t: '3. Quién los ve',
    p: 'Tus publicaciones y mensajes solo los ven las partes implicadas (reglas RLS). Tu teléfono y correo <b>nunca</b> se publican: el contacto es por chat interno.',
  },
  {
    t: '4. Tus derechos (ARCO)',
    p: 'Puedes acceder, rectificar, cancelar u oponerte al uso de tus datos editando tu <a href="/perfil" class="link">perfil</a> o escribiendo al equipo del proyecto. Eliminar tu cuenta borra tus datos personales (las mascotas adoptadas conservan registro mínimo histórico).',
  },
  {
    t: '5. Conservación y seguridad',
    p: 'Claves gestionadas por Supabase Auth (hash, nunca en claro), acceso por roles (RLS) y copias de respaldo manuales durante el piloto.',
  },
  {
    t: '6. Consentimiento',
    p: 'Al registrarte aceptas este aviso marcando la casilla correspondiente. Si no estás de acuerdo, no uses la plataforma.',
  },
];
---

<Layout title="Adopty — Aviso de privacidad" description="Cómo usa Adopty tus datos personales (Ley 81 de Panamá).">
  <Navbar />
  <main class="max-w-3xl mx-auto px-4 mt-6">
    <article class="soft-card p-6 sm:p-9">
      <header class="border-b border-line pb-5">
        <h1 class="font-display font-extrabold text-3xl">Aviso de privacidad</h1>
        <p class="text-xs mt-2 text-muted">
          Conforme a la Ley 81 de 2019 de Protección de Datos Personales de Panamá
        </p>
      </header>

      <div class="grid gap-6 mt-6 text-sm leading-relaxed">
        {
          SECCIONES.map((s) => (
            <section>
              <h2 class="font-display font-bold text-base">{s.t}</h2>
              <p class="mt-1.5 text-muted" set:html={s.p} />
            </section>
          ))
        }
      </div>

      <p class="text-xs text-faint mt-8 pt-5 border-t border-line">
        ¿Dudas sobre este aviso? Escríbenos desde el <a href="/perfil" class="link">perfil</a> de tu
        cuenta.
      </p>
    </article>
  </main>
</Layout>