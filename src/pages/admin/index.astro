---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import {
  cuentaBadge,
  esAdmin,
  fechaCorta,
  LIMITE_PANEL,
  listarCuentas,
  listarReportes,
  listarVerificaciones,
  reporteBadge,
  verifBadge,
  type CuentaAdmin,
  type EstadoReporte,
  type EstadoVerificacion,
  type ReporteAdmin,
  type VerificacionAdmin,
} from '../../lib/admin';
import { supabaseServer } from '../../lib/supabase';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/admin');

const supabase = supabaseServer(Astro.cookies);

// Doble barrera: si no es admin, 404 (no revelamos que el panel existe).
if (!(await esAdmin(supabase))) {
  Astro.response.status = 404;
}

const esAdminUser = Astro.response.status !== 404;

// Pestañas por URL: el panel sigue funcionando sin JavaScript.
const ESTADOS_REPORTE: EstadoReporte[] = ['pendiente', 'resuelto', 'descartado'];
const ESTADOS_VERIF: EstadoVerificacion[] = ['pendiente', 'aprobada', 'rechazada'];
const ETIQUETA_REPORTE: Record<EstadoReporte, string> = {
  pendiente: 'Pendientes',
  resuelto: 'Ocultadas',
  descartado: 'Descartados',
};
const ETIQUETA_VERIF: Record<EstadoVerificacion, string> = {
  pendiente: 'Pendientes',
  aprobada: 'Aprobadas',
  rechazada: 'Rechazadas',
};

const reRaw = Astro.url.searchParams.get('re') ?? 'pendiente';
const veRaw = Astro.url.searchParams.get('ve') ?? 'pendiente';
const re: EstadoReporte = ESTADOS_REPORTE.includes(reRaw as EstadoReporte)
  ? (reRaw as EstadoReporte)
  : 'pendiente';
const ve: EstadoVerificacion = ESTADOS_VERIF.includes(veRaw as EstadoVerificacion)
  ? (veRaw as EstadoVerificacion)
  : 'pendiente';

let reportes: ReporteAdmin[] = [];
let verificaciones: VerificacionAdmin[] = [];
let cuentas: CuentaAdmin[] = [];
let pendientesReportes = 0;
let pendientesVerif = 0;
let suspendidas = 0;
let errorMsg = '';

if (esAdminUser) {
  try {
    // Los contadores del resumen siempre miran los pendientes;
    // la lista grande muestra la pestaña activa.
    const [listaRe, listaVe, listaCuentas, pendRe, pendVe] = await Promise.all([
      listarReportes(supabase, re),
      listarVerificaciones(supabase, ve),
      listarCuentas(supabase),
      re === 'pendiente' ? Promise.resolve(null) : listarReportes(supabase, 'pendiente'),
      ve === 'pendiente' ? Promise.resolve(null) : listarVerificaciones(supabase, 'pendiente'),
    ]);
    reportes = listaRe;
    verificaciones = listaVe;
    cuentas = listaCuentas;
    pendientesReportes = re === 'pendiente' ? listaRe.length : (pendRe?.length ?? 0);
    pendientesVerif = ve === 'pendiente' ? listaVe.length : (pendVe?.length ?? 0);
    suspendidas = listaCuentas.filter((c) => !c.activo).length;
  } catch (e) {
    errorMsg = e instanceof Error ? e.message : 'Error al cargar el panel';
  }
}

const TIPO_EVIDENCIA: Record<string, string> = {
  redes_sociales: 'Redes sociales',
  documento: 'Documento',
  sitio_web: 'Sitio web',
  otro: 'Otro',
};

const tabRe = (estado: EstadoReporte) => ({ href: `/admin?re=${estado}&ve=${ve}`, activo: re === estado });
const tabVe = (estado: EstadoVerificacion) => ({ href: `/admin?re=${re}&ve=${estado}`, activo: ve === estado });
---

<Layout title={esAdminUser ? 'Adopty — Panel de administración' : 'Adopty — No encontrado'}>
  <Navbar />
  <main class="max-w-5xl mx-auto px-4 mt-6 mb-8">
    {
      !esAdminUser ? (
        <div class="soft-card p-10 text-center">
          <p class="text-5xl" aria-hidden="true">🚫</p>
          <h1 class="font-display font-extrabold text-2xl mt-4">No encontrado</h1>
          <p class="text-sm mt-2 text-muted">Esta página no existe o no tienes acceso.</p>
          <a href="/" class="btn-primary text-sm px-6 py-2.5 mt-6">Ir al inicio</a>
        </div>
      ) : (
        <>
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
              <h1 class="font-display font-extrabold text-2xl">Panel de administración</h1>
              <p class="text-sm mt-1 text-muted">
              Moderación de publicaciones, verificación de organizaciones y estado de las cuentas.
            </p>
            </div>
          </div>

          {errorMsg && <p class="alert alert-error mt-5" role="alert">{errorMsg}</p>}
          <p id="adminEstado" class="alert alert-ok mt-4 hidden" role="status" aria-live="polite"></p>

          <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 mt-5" role="status" aria-label="Resumen">
            <div class="soft-card p-5 text-center">
              <p class="font-display font-extrabold text-3xl text-ink tabular">{pendientesReportes}</p>
              <p class="text-xs mt-1 text-muted">Reportes pendientes</p>
            </div>
            <div class="soft-card p-5 text-center">
              <p class="font-display font-extrabold text-3xl text-ink tabular">{pendientesVerif}</p>
              <p class="text-xs mt-1 text-muted">Verificaciones pendientes</p>
            </div>
            <div class="soft-card p-5 text-center">
              <p class="font-display font-extrabold text-3xl text-ink tabular">{cuentas.length}</p>
              <p class="text-xs mt-1 text-muted">Cuentas registradas</p>
            </div>
            <div class="soft-card p-5 text-center col-span-2 lg:col-span-1">
              <p class="font-display font-extrabold text-3xl text-brand tabular">
                {pendientesReportes + pendientesVerif}
              </p>
              <p class="text-xs mt-1 text-muted">Total por revisar</p>
            </div>
          </div>

          {/* ---------- Reportes ---------- */}
          <section class="mt-8" aria-labelledby="sec-reportes">
            <h2 id="sec-reportes" class="font-display font-extrabold text-lg">Reportes de publicación</h2>
            <p class="text-xs text-muted mt-1">
              Por privacidad solo se muestra el <b>nombre</b> de quien reportó, nunca su correo.
            </p>

            <nav class="flex gap-2 mt-3 flex-wrap" aria-label="Filtrar reportes por estado">
              {ESTADOS_REPORTE.map((e) => (
                <a href={tabRe(e).href} class="tab" aria-current={re === e ? 'page' : undefined}>
                  {ETIQUETA_REPORTE[e]}
                  {e === 'pendiente' && pendientesReportes > 0 && (
                    <span class="tab-cuenta">{pendientesReportes}</span>
                  )}
                </a>
              ))}
            </nav>

            {reportes.length === 0 ? (
              <div class="soft-card p-8 mt-3 text-center">
                <p class="text-3xl" aria-hidden="true">✅</p>
                <p class="text-sm mt-2 text-muted">
                  {re === 'pendiente' ? 'No hay reportes pendientes.' : 'No hay reportes en esta bandeja.'}
                </p>
              </div>
            ) : (
              <div class="grid gap-4 mt-3">
                {reportes.map((r) => {
                  const [cls, dot, etiqueta] = reporteBadge(r.estado);
                  const oculta = Boolean(r.mascota.deleted_at);
                  return (
                    <article class="soft-card p-5" data-reporte={r.id}>
                      <div class="flex items-center gap-2 flex-wrap">
                        <a
                          href={`/mascota/${r.mascota.slug ?? r.mascota.id}`}
                          class="font-display font-bold text-ink hover:underline"
                        >
                          {r.mascota.nombre}
                        </a>
                        <span class={`badge ${cls}`}>
                          <span class="dot" style={`background:${dot}`} />
                          {etiqueta}
                        </span>
                        {oculta && (
                          <span class="badge badge-adoptada">
                            <span class="dot" style="background:#94A3B8" />
                            Oculta
                          </span>
                        )}
                        <span class="text-xs ml-auto text-faint tabular">{fechaCorta(r.fecha_reporte)}</span>
                      </div>
                      <p class="text-xs text-muted mt-1">
                        {r.mascota.ubicacion} · Reportado por <b>{r.reportador}</b>
                      </p>
                      <p class="text-sm mt-3 p-3 rounded-xl bg-surface text-muted italic">“{r.motivo}”</p>
                      {r.notas_admin && (
                        <p class="text-xs mt-2 text-muted">
                          <b>Nota de moderación:</b> {r.notas_admin}
                        </p>
                      )}

                      {r.estado === 'pendiente' ? (
                        <>
                          <div class="flex gap-2 mt-4 flex-wrap">
                            <button type="button" data-ocultar={r.id} class="btn-primary text-sm px-5 py-2.5">
                              Ocultar publicación
                            </button>
                            <button type="button" data-descartar={r.id} class="btn-ghost text-sm px-5 py-2.5">
                              Descartar reporte
                            </button>
                          </div>
                          <p class="text-xs mt-2 text-faint">
                            Ocultar la esconde de Explorar (reversible) y descarta los demás reportes de
                            esa mascota.
                          </p>
                        </>
                      ) : (
                        <div class="flex items-center gap-2 mt-4 flex-wrap">
                          {
                            oculta ? (
                              <button
                                type="button"
                                data-restaurar={r.mascota.id}
                                class="btn-ghost text-sm px-5 py-2.5"
                              >
                                Restaurar publicación
                              </button>
                            ) : (
                              <span class="text-xs text-muted">
                                {r.estado === 'resuelto'
                                  ? 'Resuelto · la publicación sigue visible'
                                  : 'Reporte descartado · la publicación sigue visible'}
                              </span>
                            )
                          }
                          {r.fecha_resolucion && (
                            <span class="text-xs text-faint">
                              Resuelto el {fechaCorta(r.fecha_resolucion)}
                            </span>
                          )}
                        </div>
                      )}
                      <p
                        data-err={r.id}
                        class="alert alert-error text-xs mt-2 hidden"
                        role="alert"
                        aria-live="polite"
                      />
                    </article>
                  );
                })}
              </div>
            )}
            {reportes.length === LIMITE_PANEL && (
              <p class="text-xs text-faint mt-3">Mostrando los {LIMITE_PANEL} más recientes.</p>
            )}
          </section>

          {/* ---------- Verificaciones ---------- */}
          <section class="mt-8" aria-labelledby="sec-verif">
            <h2 id="sec-verif" class="font-display font-extrabold text-lg">
              Verificaciones de organizaciones
            </h2>

            <nav class="flex gap-2 mt-3 flex-wrap" aria-label="Filtrar verificaciones por estado">
              {ESTADOS_VERIF.map((e) => (
                <a href={tabVe(e).href} class="tab" aria-current={ve === e ? 'page' : undefined}>
                  {ETIQUETA_VERIF[e]}
                  {e === 'pendiente' && pendientesVerif > 0 && (
                    <span class="tab-cuenta">{pendientesVerif}</span>
                  )}
                </a>
              ))}
            </nav>

            {verificaciones.length === 0 ? (
              <div class="soft-card p-8 mt-3 text-center">
                <p class="text-3xl" aria-hidden="true">✅</p>
                <p class="text-sm mt-2 text-muted">
                  {ve === 'pendiente'
                    ? 'No hay solicitudes de verificación pendientes.'
                    : 'No hay solicitudes en esta bandeja.'}
                </p>
              </div>
            ) : (
              <div class="grid gap-4 mt-3">
                {verificaciones.map((v) => {
                  const [cls, dot, etiqueta] = verifBadge(v.estado);
                  return (
                    <article class="soft-card p-5" data-verif={v.id}>
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-display font-bold text-ink">{v.organizacion.nombre_oficial}</span>
                        <span class={`badge ${cls}`}>
                          <span class="dot" style={`background:${dot}`} />
                          {etiqueta}
                        </span>
                        {v.organizacion.verificada && (
                          <span class="badge badge-disponible">✓ badge activo</span>
                        )}
                        <span class="text-xs ml-auto text-faint tabular">
                          {fechaCorta(v.fecha_solicitud)}
                        </span>
                      </div>
                      <p class="text-xs text-muted mt-1">
                        Evidencia: <b>{TIPO_EVIDENCIA[v.tipo_evidencia] ?? v.tipo_evidencia}</b>
                      </p>
                      <details class="mt-2">
                        <summary class="text-xs font-semibold text-ink cursor-pointer">
                          Lo que declara en su perfil
                        </summary>
                        <div class="text-xs text-muted mt-1.5 grid gap-0.5">
                          <p>
                            Sitio web:{' '}
                            {v.organizacion.sitio_web ? (
                              <span class="break-all">{v.organizacion.sitio_web}</span>
                            ) : (
                              <i>no indicó</i>
                            )}
                          </p>
                          {(
                            [
                              ['Instagram', v.organizacion.redes?.instagram],
                              ['Facebook', v.organizacion.redes?.facebook],
                              ['WhatsApp', v.organizacion.redes?.whatsapp],
                            ] as const
                          ).map(([red, valor]) => (
                            <p>
                              {red}: {valor ? <span class="break-all">{valor}</span> : <i>no indicó</i>}
                            </p>
                          ))}
                          <p class="text-faint mt-1">
                            No hacemos peticiones a esas direcciones desde el servidor: contrasta tú
                            mismo antes de aprobar.
                          </p>
                        </div>
                      </details>
                      <a
                        href={v.url_evidencia}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link text-xs break-all mt-1 inline-block"
                      >
                        {v.url_evidencia}
                      </a>
                      {v.descripcion && <p class="text-sm mt-2">“{v.descripcion}”</p>}
                      {v.notas_admin && (
                        <p class="text-xs mt-2 text-muted">
                          <b>Nota enviada a la organización:</b> {v.notas_admin}
                        </p>
                      )}

                      {v.estado === 'pendiente' ? (
                        <>
                          <div class="grid gap-2 mt-4">
                            <label class="label" for={`notas-${v.id}`}>
                              Notas para la organización <span class="font-normal normal-case">(opcional)</span>
                            </label>
                            <input
                              id={`notas-${v.id}`}
                              data-notas={v.id}
                              maxlength="500"
                              class="input-soft text-sm"
                              placeholder="Motivo de la decisión o evidencia revisada"
                            />
                          </div>
                          <div class="flex gap-2 mt-3 flex-wrap">
                            <button type="button" data-aprobar={v.id} class="btn-primary text-sm px-5 py-2.5">
                              Aprobar y verificar
                            </button>
                            <button type="button" data-rechazar={v.id} class="btn-ghost text-sm px-5 py-2.5">
                              Rechazar
                            </button>
                          </div>
                        </>
                      ) : (
                        v.fecha_resolucion && (
                          <p class="text-xs text-faint mt-3">
                            Resuelto el {fechaCorta(v.fecha_resolucion)}
                          </p>
                        )
                      )}
                      <p
                        data-err={v.id}
                        class="alert alert-error text-xs mt-2 hidden"
                        role="alert"
                        aria-live="polite"
                      />
                    </article>
                  );
                })}
              </div>
            )}
          </section>

          {/* ---------- Cuentas (suspender / reactivar) ---------- */}
          <section class="mt-10" aria-labelledby="sec-cuentas">
            <h2 id="sec-cuentas" class="font-display font-extrabold text-lg">Cuentas</h2>
            <p class="text-xs text-muted mt-1">
              Suspender deja entrar la cuenta: la sesión se cierra en la siguiente petición y no
              puede volver a iniciar sesión. <b>No</b> borra nada: las publicaciones y los mensajes
              siguen ahí. Por privacidad solo se muestra el nombre, nunca el correo.
              {suspendidas > 0 && ` Hay ${suspendidas} suspendida(s).`}
            </p>

            <div class="grid gap-3 mt-3">
              {cuentas.map((c) => {
                const [cls, dot, etiqueta] = cuentaBadge(c.activo);
                const baja = Boolean(c.borrado_en);
                return (
                  <article class="soft-card p-4 flex items-center gap-3 flex-wrap" data-cuenta={c.id}>
                    <div class="min-w-0">
                      <p class="text-sm font-bold text-ink flex items-center gap-2 flex-wrap">
                        {c.nombre}
                        <span class="text-xs font-normal text-faint">
                          {c.tipo === 'organizacion' ? 'Organización' : 'Persona'}
                        </span>
                      </p>
                      <p class="text-xs text-faint mt-0.5">
                        {c.mascotas} publicación{c.mascotas === 1 ? '' : 'es'} ·{' '}
                        {fechaCorta(c.fecha_registro)}
                        {baja && ' · dada de baja por la persona'}
                      </p>
                    </div>
                    <span class={`badge ${cls} ml-auto`}>
                      <span class="dot" style={`background:${dot}`} />
                      {baja ? 'Dada de baja' : etiqueta}
                    </span>
                    {!baja && (
                      <button
                        type="button"
                        data-alternar={c.id}
                        data-activo={String(c.activo)}
                        class={`btn-ghost text-xs px-4 py-2 ${c.activo ? 'text-danger' : ''}`}
                      >
                        {c.activo ? 'Suspender' : 'Reactivar'}
                      </button>
                    )}
                  </article>
                );
              })}
              {cuentas.length === 0 && (
                <div class="soft-card p-8 text-center">
                  <p class="text-sm text-muted">No hay cuentas registradas.</p>
                </div>
              )}
            </div>
          </section>

          <p class="text-xs mt-8 text-faint">
            Las decisiones quedan registradas en la auditoría de la base de datos.
          </p>
        </>
      )
    }
  </main>

  <script>
    const mostrarErr = (id, msg) => {
      const el = document.querySelector(`[data-err="${id}"]`);
      if (el) {
        el.textContent = msg;
        el.classList.remove('hidden');
      }
    };
    const notasDe = (id) => {
      const el = document.querySelector(`[data-notas="${id}"]`);
      return el && 'value' in el ? String(el.value).trim() : '';
    };

    const avisar = (msg, tipo) => {
      const el = document.getElementById('adminEstado');
      if (!el) return;
      el.textContent = msg;
      el.classList.remove('hidden');
      el.classList.toggle('alert-ok', tipo === 'ok');
      el.classList.toggle('alert-error', tipo !== 'ok');
    };

    const enviar = async (url, cuerpo, okMsg) => {
      avisar('Procesando…', 'proceso');
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cuerpo),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        avisar(data.error || 'No se pudo procesar', 'error');
        return { ok: false, error: data.error || 'No se pudo procesar' };
      }
      avisar(okMsg, 'ok');
      return { ok: true };
    };

    async function accionReporte(id, accion) {
      const msg =
        accion === 'ocultar'
          ? '¿Ocultar esta publicación? Dejará de verse en Explorar (se puede restaurar desde la bandeja "Ocultadas"). Los demás reportes de esta mascota se descartarán.'
          : '¿Descartar este reporte? No se ocultará la publicación.';
      if (!confirm(msg)) return;
      const r = await enviar(`/api/admin/reportes/${id}`, { accion },
        accion === 'ocultar' ? 'Publicación oculta.' : 'Reporte descartado.');
      if (!r.ok) return mostrarErr(id, r.error);
      location.reload();
    }

    async function accionRestaurar(mascotaId) {
      if (!confirm('¿Restaurar esta publicación? Volverá a verse en Explorar.')) return;
      const r = await enviar(`/api/admin/mascotas/${mascotaId}/restaurar`, {}, 'Publicación restaurada.');
      if (!r.ok) return;
      location.reload();
    }

    async function accionVerif(id, aprobar) {
      const msg = aprobar
        ? '¿Aprobar la verificación? La organización verá el badge "verificada".'
        : '¿Rechazar la verificación?';
      if (!confirm(msg)) return;
      const r = await enviar(`/api/admin/verificaciones/${id}`, { aprobar, notas: notasDe(id) },
        aprobar ? 'Organización verificada.' : 'Solicitud rechazada.');
      if (!r.ok) return mostrarErr(id, r.error);
      location.reload();
    }

    async function alternarCuenta(id, activo, boton) {
      const msg = activo
        ? '¿Suspender esta cuenta? Dejará de poder entrar; sus publicaciones y mensajes no se borran.'
        : '¿Reactivar esta cuenta? Volverá a poder entrar con normalidad.';
      if (!confirm(msg)) return;
      boton.disabled = true;
      const previo = boton.textContent;
      boton.textContent = activo ? 'Suspendiendo…' : 'Reactivando…';
      const res = await fetch('/api/admin/cuentas', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, activo: !activo }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        avisar(data.error || 'No se pudo cambiar el estado', 'error');
        boton.disabled = false;
        boton.textContent = previo;
        return;
      }
      location.reload();
    }

    document.querySelectorAll('[data-alternar]').forEach((b) =>
      b.addEventListener('click', () =>
        alternarCuenta(
          b.getAttribute('data-alternar'),
          b.getAttribute('data-activo') === 'true',
          b,
        ),
      ),
    );

    document.querySelectorAll('[data-ocultar]').forEach((b) =>
      b.addEventListener('click', () =>
        accionReporte(b.getAttribute('data-ocultar'), 'ocultar'),
      ),
    );
    document.querySelectorAll('[data-descartar]').forEach((b) =>
      b.addEventListener('click', () =>
        accionReporte(b.getAttribute('data-descartar'), 'descartar'),
      ),
    );
    document.querySelectorAll('[data-restaurar]').forEach((b) =>
      b.addEventListener('click', () => accionRestaurar(b.getAttribute('data-restaurar'))),
    );
    document.querySelectorAll('[data-aprobar]').forEach((b) =>
      b.addEventListener('click', () => accionVerif(b.getAttribute('data-aprobar'), true)),
    );
    document.querySelectorAll('[data-rechazar]').forEach((b) =>
      b.addEventListener('click', () => accionVerif(b.getAttribute('data-rechazar'), false)),
    );
  </script>
</Layout>
