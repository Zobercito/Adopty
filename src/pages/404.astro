---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---
<Layout title="Adopty — Página no encontrada" description="La página que buscas no existe en Adopty.">
  <Navbar active="inicio" />
  <main class="max-w-md mx-auto px-4 mt-16 text-center">
    <div class="soft-card p-10">
      <p class="text-6xl" aria-hidden="true">🐾</p>
      <h1 class="font-display font-extrabold text-3xl mt-4" style="color:#1E293B">404 — Se escapó</h1>
      <p class="text-sm mt-2">Esta mascota (o página) no existe o fue adoptada.</p>
      <div class="flex gap-2 justify-center mt-6">
        <a href="/" class="btn-ghost text-sm px-5 py-2.5">Inicio</a>
        <a href="/explorar" class="btn-primary text-sm px-5 py-2.5">Explorar</a>
      </div>
    </div>
  </main>
</Layout>
