---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Badge from '../components/Badge.astro';
import { supabaseServer } from '../lib/supabase';
import { estadoLabel, fotoUrl, fotosOrdenadas, gradFor, type FotoRow } from '../lib/mascotas';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/favoritos');

const supabase = supabaseServer(Astro.cookies);
// Favoritos reales (UUIDs) + mascota visible por RLS + foto principal.
const { data: favs, error } = await supabase
  .from('favoritos')
  .select(
    'id_mascota, mascotas(id, nombre, raza, ubicacion, estado, id_publicador, fotos_mascota(url_foto, es_principal, orden))',
  )
  .eq('id_usuario', user.id)
  .order('fecha', { ascending: false });
const reales = ((favs ?? []) as { id_mascota: string; mascotas: unknown }[])
  .filter((f) => f.mascotas)
  .map((f) => {
    const m = f.mascotas as unknown as {
      id: string;
      nombre: string;
      raza: string;
      ubicacion: string;
      estado: string;
      id_publicador: string;
      fotos_mascota: FotoRow[];
    };
    const fotos = fotosOrdenadas(m.fotos_mascota);
    return {
      id: m.id,
      nombre: m.nombre,
      raza: m.raza,
      ubicacion: m.ubicacion,
      estado: estadoLabel(m.estado),
      id_publicador: m.id_publicador,
      eyebrow: `📍 ${m.ubicacion}`,
      fotos,
    };
  });
const errorMsg = error?.message ?? '';
---

<Layout title="Adopty — Mis favoritos">
  <Navbar />
  <main class="max-w-6xl mx-auto px-4 mt-6">
    <div class="flex items-end justify-between flex-wrap gap-3">
      <div>
        <h1 class="font-display font-extrabold text-2xl">Mis favoritos</h1>
        <p class="text-sm mt-1 text-muted">
          Guardados en tu cuenta y visibles en todos tus dispositivos.
        </p>
      </div>
      {reales.length > 0 && <a href="/explorar" class="link text-sm">Explorar más →</a>}
    </div>

    <p id="localWrap" class="alert alert-info text-xs mt-4 hidden">
      Tienes <span id="localCount" class="font-bold">0</span> favorita(s) guardadas solo en este
      navegador (catálogo de demostración). Entra con una cuenta con datos reales para migrarlas.
    </p>

    {errorMsg && <p class="alert alert-error mt-4" role="alert">{errorMsg}</p>}

    {
      reales.length === 0 ? (
        <div class="soft-card p-10 mt-6 text-center">
          <p class="text-5xl" aria-hidden="true">
            🤍
          </p>
          <h2 class="font-display font-bold text-lg mt-4">Aún no guardas favoritas</h2>
          <p class="text-sm mt-2 text-muted">
            Toca el <span class="text-brand">♥</span> en cualquier mascota y aparecerá aquí.
          </p>
          <a href="/explorar" class="btn-primary text-sm px-6 py-2.5 mt-5">
            Explorar mascotas
          </a>
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-6">
          {reales.map((p) => (
            <article class="soft-card overflow-hidden lift flex flex-col">
              <a href={`/mascota/${p.id}`} class="block relative">
                <div class={`pet-photo ${gradFor(p.id)} w-full h-48`}>
                  {p.fotos[0] && (
                    <img
                      src={fotoUrl(p.fotos[0].url_foto)}
                      alt={p.nombre}
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="384"
                      class="absolute inset-0 w-full h-full object-cover"
                      onerror="this.remove()"
                    />
                  )}
                </div>
              </a>
              <div class="p-4 flex-1 flex flex-col">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="font-display font-extrabold text-lg text-ink truncate">{p.nombre}</h3>
                  <Badge estado={p.estado} />
                </div>
                <p class="text-xs font-semibold text-muted mt-1">
                  {p.raza} · {p.ubicacion}
                </p>
                <div class="flex gap-2 mt-4 pt-3 border-t border-line">
                  <a href={`/mascota/${p.id}`} class="btn-primary text-xs px-4 py-2 flex-1 text-center">
                    Ver perfil
                  </a>
                  <a
                    href={`/mensajes?mascota=${p.id}&con=${p.id_publicador}`}
                    class="btn-ghost text-xs px-4 py-2 flex-1 text-center"
                  >
                    Enviar mensaje
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </main>

  <script>
    // Conteo de favs demo locales (ids no-UUID del mock Fase 0).
    try {
      const f = JSON.parse(localStorage.getItem('adopty_favs') || '[]');
      const demo = f.filter((x) => !/^[0-9a-f-]{36}$/i.test(x));
      if (demo.length) {
        document.getElementById('localCount').textContent = String(demo.length);
        document.getElementById('localWrap').classList.remove('hidden');
      }
    } catch {}
  </script>
</Layout>