---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import PetForm from '../../../components/PetForm.astro';
import { supabaseServer } from '../../../lib/supabase';
import { fotosOrdenadas, type MascotaRow, type FotoRow } from '../../../lib/mascotas';

const { id } = Astro.params;
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=' + encodeURIComponent(`/mascota/${id}/editar`));

const supabase = supabaseServer(Astro.cookies);
const { data } = await supabase
  .from('mascotas')
  .select('*, fotos_mascota(*)')
  .eq('id', id ?? '')
  .is('deleted_at', null)
  .maybeSingle();

const pet = data
  ? ({
      ...(data as MascotaRow),
      fotos: fotosOrdenadas((data as { fotos_mascota: FotoRow[] }).fotos_mascota),
    } as MascotaRow & { fotos: FotoRow[] })
  : null;
const esDueno = pet?.id_publicador === user.id;
if (!pet || !esDueno) {
  Astro.response.status = 404;
}
---

<Layout title={pet ? `Adopty — Editar a ${pet.nombre}` : 'Adopty — No encontrada'}>
  <Navbar />
  <main class="max-w-3xl mx-auto px-4 mt-6">
    {
      pet && esDueno ? (
        <div class="soft-card p-6 sm:p-8">
          <div class="flex items-start justify-between flex-wrap gap-3">
            <div>
              <h1 class="font-display font-extrabold text-2xl">Editar a {pet.nombre}</h1>
              <p class="text-sm mt-1 text-muted">Los cambios se reflejan al instante en Explorar.</p>
            </div>
            <a href={`/mascota/${pet.id}`} class="link text-sm">
              Ver ficha →
            </a>
          </div>

          <div class="mt-7">
            <PetForm mode="edit" pet={pet} />
          </div>

          <section class="mt-8 pt-5 border-t border-line" aria-labelledby="t-peligro">
            <h2 id="t-peligro" class="text-sm font-bold text-danger">
              Zona de peligro
            </h2>
            <p class="text-xs mt-1 text-muted">
              Se oculta de Explorar (borrado lógico). Sus solicitudes y mensajes se conservan.
            </p>
            <button id="delBtn" class="btn-danger text-sm px-5 py-2.5 mt-3" type="button">
              Eliminar publicación
            </button>
          </section>
        </div>
      ) : (
        <div class="soft-card p-10 text-center">
          <p class="text-6xl" aria-hidden="true">
            🐾
          </p>
          <h1 class="font-display font-extrabold text-2xl mt-4">404 — No encontrada</h1>
          <p class="text-sm mt-2 text-muted">
            Esta mascota no existe, fue eliminada o no eres su publicador.
          </p>
          <a href="/explorar" class="btn-primary text-sm px-6 py-2.5 mt-5">
            Explorar mascotas
          </a>
        </div>
      )
    }
  </main>
  {
    pet && esDueno && (
      <script define:vars={{ petId: pet.id }}>
        document.getElementById('delBtn').addEventListener('click', async () => {
          if (!confirm('¿Seguro que quieres eliminar esta publicación?')) return;
          const btn = document.getElementById('delBtn');
          btn.disabled = true;
          btn.textContent = 'Eliminando…';
          const res = await fetch(`/api/mascotas/${petId}`, { method: 'DELETE' });
          if (res.ok) {
            location.href = '/explorar';
          } else {
            btn.disabled = false;
            btn.textContent = 'Eliminar publicación';
            alert('No se pudo eliminar');
          }
        });
      </script>
    )
  }
</Layout>