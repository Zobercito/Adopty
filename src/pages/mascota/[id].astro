---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Badge from '../../components/Badge.astro';
import FavButton from '../../components/FavButton.astro';
import { supabaseServer } from '../../lib/supabase';
import { estadoLabel, edadLabel, fotoUrl, fotosOrdenadas, gradFor, type FotoRow, type MascotaRow } from '../../lib/mascotas';
import { perfilesPublicos } from '../../lib/perfil';

const { id } = Astro.params;
const supabase = supabaseServer(Astro.cookies);
const user = Astro.locals.user;

// Acepta slug (toby-a1b2c3) o UUID directo
const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id ?? '');
const { data } = await supabase
  .from('mascotas')
  .select('*, fotos_mascota(*)')
  .or(isUuid ? `id.eq.${id}` : `slug.eq.${id}`)
  .is('deleted_at', null)
  .maybeSingle();

const pet = (data ?? null) as (MascotaRow & { fotos_mascota: FotoRow[] }) | null;
// Redirige a URL con slug si vino por UUID
if (pet && isUuid && pet.slug) {
  return Astro.redirect(`/mascota/${pet.slug}`, 301);
}
const esDueno = !!(pet && user && user.id === pet.id_publicador);
let noExiste = !pet;
// Mi última solicitud sobre esta mascota (para pintar solicitar / pendiente / aprobada)
let miSolicitud: { id: string; estado: string } | null = null;
if (pet && user && !esDueno) {
  const { data: s } = await supabase
    .from('solicitudes')
    .select('id,estado')
    .eq('id_mascota', pet.id)
    .eq('id_adoptante', user.id)
    .order('fecha_solicitud', { ascending: false })
    .limit(1);
  miSolicitud = ((s?.[0] ?? null) as { id: string; estado: string } | null);
}
if (pet) {
  if (pet.estado !== 'disponible' && !esDueno) {
    // El adoptante aprobado puede seguir viendo la ficha para coordinar la entrega
    if (!(miSolicitud && miSolicitud.estado === 'aprobada')) noExiste = true;
  }
}
if (noExiste) Astro.response.status = 404;

const fotos = pet ? fotosOrdenadas(pet.fotos_mascota) : [];
const grad = pet ? gradFor(pet.id) : 'pet-grad-1';
// OG image absoluta (los assets del seed son rutas relativas /assets/…)
const ogRel = fotos[0] ? fotoUrl(fotos[0].url_foto) : '';
const ogImage = ogRel
  ? ogRel.startsWith('http')
    ? ogRel
    : new URL(ogRel, Astro.site ?? Astro.url.origin).toString()
  : undefined;

let publicador = 'Publicador';
let verificada = false;
let sitioWeb: string | null = null;
let redes: { instagram?: string; facebook?: string; whatsapp?: string } | null = null;
const publicadorId = pet?.id_publicador ?? '';
// Solicitud aprobada de esta mascota (para el chat del publicador)
let solicitudAprobada: { id: string; id_adoptante: string } | null = null;
if (pet && user && esDueno) {
  const { data: ap } = await supabase
    .from('solicitudes')
    .select('id,id_adoptante')
    .eq('id_mascota', pet.id)
    .eq('estado', 'aprobada')
    .order('fecha_solicitud', { ascending: false })
    .limit(1);
  solicitudAprobada = ((ap?.[0] ?? null) as { id: string; id_adoptante: string } | null);
}
if (pet) {
  // La ficha es pública (se ve sin sesión), así que el nombre del publicador sale del
  // RPC `perfil_publico`: es lo único legible sin estar autenticado.
  const pub = (await perfilesPublicos(supabase, [pet.id_publicador])).get(pet.id_publicador);
  publicador = pub?.nombre ?? 'Publicador';
  verificada = Boolean(pub?.verificada);
  // Solo llegan si la organización está verificada: son datos declarados por ella.
  sitioWeb = pub?.sitio_web ?? null;
  redes = pub?.redes ?? null;
}

// [clave dentro de `redes`, etiqueta visible, constructor de la URL]
const REDES: [string, string, (v: string) => string][] = [
  ['instagram', 'Instagram', (v) => `https://instagram.com/${v.replace(/^@/, '')}`],
  ['facebook', 'Facebook', (v) => (v.startsWith('http') ? v : `https://${v}`)],
  ['whatsapp', 'WhatsApp', (v) => `https://wa.me/${v.replace(/[^\d]/g, '')}`],
];
const fecha = pet
  ? new Date(pet.fecha_publicacion).toLocaleDateString('es-PA', { day: 'numeric', month: 'short', year: 'numeric' })
  : '';
const fila = (etiqueta: string, valor: string) => ({ etiqueta, valor });
const datos = pet
  ? [
      fila('Especie', pet.especie === 'otro' ? 'Otro' : pet.especie.charAt(0).toUpperCase() + pet.especie.slice(1)),
      fila('Raza', pet.raza),
      fila('Edad', edadLabel(pet.edad_meses)),
      fila('Sexo', pet.sexo),
      fila('Tamaño', pet.tamano),
      fila('Ubicación', pet.ubicacion),
      fila('Publicado', fecha),
    ]
  : [];
---
<Layout
  title={pet ? `Adopty — ${pet.nombre}, ${pet.raza} en adopción` : 'Adopty — No encontrada'}
  description={pet ? `${pet.nombre}: ${pet.descripcion.slice(0, 150)}` : undefined}
  ogImage={ogImage}
>
  <Navbar active="explorar" />
  <main class="max-w-6xl mx-auto px-4 mt-6 mb-4">
    {
      noExiste || !pet ? (
        <div class="soft-card p-10 text-center">
          <p class="text-6xl" aria-hidden="true">
            🐾
          </p>
          <h1 class="font-display font-extrabold text-3xl mt-4">404 — No encontrada</h1>
          <p class="text-sm mt-2 text-muted">
            Esta mascota no existe, ya fue adoptada y oculta, o fue eliminada.
          </p>
          <a href="/explorar" class="btn-primary text-sm px-6 py-2.5 mt-6">Seguir explorando</a>
        </div>
      ) : (
        <div class="grid lg:grid-cols-[1.15fr_1fr] gap-5 items-start">
          {/* ---------- Carrusel de fotos (accesible: teclado + aria-live) ---------- */}
          <section class="soft-card overflow-hidden lg:sticky lg:top-24" aria-label={`Fotos de ${pet.nombre}`}>
            <div
              id="carousel"
              tabindex="0"
              role="region"
              aria-roledescription="carrusel"
              aria-label={`Fotos de ${pet.nombre} — usa las flechas del teclado`}
              class={`relative pet-photo ${grad} h-72 sm:h-96`}
            >
              {fotos.length === 0 && (
                <span class="text-5xl" aria-hidden="true">
                  🐾
                </span>
              )}
              {fotos.map((f, i) => (
                <img
                  data-slide={i}
                  src={fotoUrl(f.url_foto)}
                  alt={`${pet.nombre} — foto ${i + 1} de ${fotos.length}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  width="900"
                  height="700"
                  class="absolute inset-0 w-full h-full object-cover slide"
                  style={`display:${i === 0 ? 'block' : 'none'}`}
                  onerror="this.remove()"
                />
              ))}
              {fotos.length > 1 && (
                <>
                  <button
                    id="prev"
                    class="carousel-btn absolute left-3 top-1/2 -translate-y-1/2"
                    aria-label="Foto anterior"
                    type="button"
                  >
                    <span aria-hidden="true">‹</span>
                  </button>
                  <button
                    id="next"
                    class="carousel-btn absolute right-3 top-1/2 -translate-y-1/2"
                    aria-label="Foto siguiente"
                    type="button"
                  >
                    <span aria-hidden="true">›</span>
                  </button>
                  <div id="dots" class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
                    {fotos.map((_, i) => (
                      <button
                        type="button"
                        data-dot={i}
                        aria-label={`Ir a foto ${i + 1}`}
                        class="dot-nav w-2.5 h-2.5 rounded-full"
                        style={`background:${i === 0 ? '#FF6B35' : 'rgba(255,255,255,.75)'}`}
                      />
                    ))}
                  </div>
                  <p
                    id="counter"
                    class="absolute top-3 right-3 text-xs font-bold px-2.5 py-1 rounded-full bg-white/90 text-ink"
                    aria-live="polite"
                  >
                    Foto 1 / {fotos.length}
                  </p>
                </>
              )}
            </div>
            {pet.descripcion && (
              <div class="p-5 border-t border-line">
                <p class="text-sm leading-relaxed">{pet.descripcion}</p>
              </div>
            )}
          </section>

          {/* ---------- Ficha ---------- */}
          <section class="soft-card p-6">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="flex items-center gap-3 flex-wrap">
                  <h1 class="font-display font-extrabold text-3xl">{pet.nombre}</h1>
                  <Badge estado={estadoLabel(pet.estado)} />
                </div>
                <p class="text-sm mt-1 text-muted">{pet.raza}</p>
              </div>
              <FavButton id={pet.id} nombre={pet.nombre} />
            </div>

            <dl class="grid grid-cols-2 gap-x-4 gap-y-3 mt-6 text-sm">
              {datos.map((d) => (
                <div class="bg-surface rounded-xl px-3 py-2">
                  <dt class="label">{d.etiqueta}</dt>
                  <dd class="text-ink mt-0.5">{d.valor}</dd>
                </div>
              ))}
            </dl>

            {pet.estado_salud && (
              <div class="mt-3 p-4 rounded-2xl bg-success-soft border border-emerald-200">
                <p class="label text-emerald-700">Salud</p>
                <p class="text-sm text-ink mt-1">{pet.estado_salud}</p>
              </div>
            )}

            {/* Publicador */}
            <div class="mt-5 p-4 rounded-2xl bg-surface flex items-center gap-3">
              <span class="avatar w-11 h-11" aria-hidden="true">
                {publicador.charAt(0).toUpperCase()}
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-bold text-ink truncate">{publicador}</p>
                <p class="text-xs text-muted">
                  {verificada ? (
                    <>
                      <span class="dot mr-1 align-middle" style="background:#10B981" />
                      Organización verificada
                    </>
                  ) : (
                    'Publicador particular'
                  )}
                </p>
              </div>
              {esDueno && (
                <a href={`/mascota/${pet.id}/editar`} class="btn-ghost text-xs px-4 py-2 shrink-0">
                  Editar
                </a>
              )}
            </div>

            {/* Canales de contacto declarados por una organización verificada */}
            {verificada && (sitioWeb || Object.values(redes ?? {}).some(Boolean)) && (
              <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                <span class="text-faint">Canales del refugio:</span>
                {sitioWeb && (
                  <a
                    href={sitioWeb.startsWith('http') ? sitioWeb : `https://${sitioWeb}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-ghost px-3 py-1.5"
                  >
                    Sitio web
                  </a>
                )}
                {REDES.map(([clave, etiqueta, url]) => {
                  const valor = redes?.[clave];
                  if (!valor) return null;
                  return (
                    <a
                      href={url(valor)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-ghost px-3 py-1.5"
                    >
                      {etiqueta}
                    </a>
                  );
                })}
              </div>
            )}
            <p class="text-xs mt-2 text-faint">
              El chat interno nunca muestra teléfonos personales.
            </p>

            {/* Solicitud de adopción (Fase 4) */}
            <div class="mt-5">
              {esDueno ? (
                <div class="alert alert-info">
                  <p>
                    <b>Es tu publicación.</b> Gestiona quién la solicita.
                  </p>
                  <a href="/panel/solicitudes" class="btn-primary text-sm px-5 py-2.5 mt-3">
                    Ver solicitudes
                  </a>
                </div>
              ) : !user ? (
                <a
                  href={`/login?next=${encodeURIComponent(`/mascota/${pet.id}`)}`}
                  class="btn-primary py-3 text-sm w-full"
                >
                  Entrar para solicitar
                </a>
              ) : !miSolicitud ||
                miSolicitud.estado === 'rechazada' ||
                miSolicitud.estado === 'cancelada' ? (
                <form id="solForm" class="grid gap-2">
                  {miSolicitud && (
                    <p class="alert alert-error">
                      Tu solicitud anterior fue{' '}
                      {miSolicitud.estado === 'rechazada' ? 'rechazada' : 'cancelada'}. Puedes
                      intentarlo de nuevo.
                    </p>
                  )}
                  <label class="label mt-1" for="mensaje">
                    ¿Por qué quieres adoptar a {pet.nombre}?
                  </label>
                  <textarea
                    id="mensaje"
                    name="mensaje"
                    required
                    minlength="10"
                    maxlength="1000"
                    rows="3"
                    class="input-soft text-sm"
                    placeholder="Cuéntale al publicador sobre tu hogar, experiencia, tiempo..."
                  />
                  <p id="solErr" class="alert alert-error hidden" role="alert" />
                  <button id="solBtn" class="btn-primary py-3 text-sm mt-1" type="submit">
                    Solicitar adopción
                  </button>
                </form>
              ) : miSolicitud.estado === 'pendiente' ? (
                <div class="alert alert-error">
                  <p>
                    <b>Solicitud pendiente.</b> El publicador la está revisando. Te avisamos aquí
                    cuando cambie.
                  </p>
                  <button
                    id="solCancel"
                    type="button"
                    class="text-xs font-bold mt-2 hover:underline"
                  >
                    Cancelar solicitud
                  </button>
                </div>
              ) : (
                <div class="alert alert-ok">
                  <p>
                    <b>¡Solicitud aprobada!</b> {pet.nombre} pasó a En proceso. Coordina la entrega
                    con {publicador}.
                  </p>
                  <p class="text-xs mt-1 font-normal">Usa el chat para acordar la entrega.</p>
                </div>
              )}
            </div>

            <div class="mt-3">
              {miSolicitud?.estado === 'aprobada' ? (
                <a
                  href={`/mensajes?mascota=${pet.id}&con=${publicadorId}`}
                  class="btn-primary py-3 text-sm w-full"
                >
                  Abrir chat
                </a>
              ) : esDueno && solicitudAprobada ? (
                <a
                  href={`/mensajes?mascota=${pet.id}&con=${solicitudAprobada.id_adoptante}`}
                  class="btn-primary py-3 text-sm w-full"
                >
                  Abrir chat con adoptante
                </a>
              ) : (
                <span
                  class="btn-ghost py-3 text-sm w-full opacity-60 cursor-not-allowed"
                  title="Requiere solicitud aprobada"
                  aria-disabled="true"
                >
                  Enviar mensaje
                </span>
              )}
            </div>

            {/* Reportar publicación: diálogo propio en vez de window.prompt */}
            {!esDueno && user && (
              <details class="mt-4">
                <summary class="text-xs text-muted hover:text-ink cursor-pointer font-semibold py-2">
                  🚩 Reportar publicación
                </summary>
                <form id="reportForm" class="mt-3 grid gap-2">
                  <label class="label" for="motivo">Motivo (mínimo 10 caracteres)</label>
                  <textarea
                    id="motivo"
                    name="motivo"
                    required
                    minlength="10"
                    maxlength="500"
                    rows="2"
                    class="input-soft text-sm"
                    placeholder="Contenido falso, fotos ajenas, inappropriate…"
                  />
                  <div class="flex gap-2">
                    <button class="btn-danger text-xs px-4 py-2" type="submit">
                      Enviar reporte
                    </button>
                    <button class="btn-quiet text-xs py-2" type="reset">
                      Cancelar
                    </button>
                  </div>
                  <p id="reportMsg" class="alert alert-ok hidden" role="status" />
                </form>
              </details>
            )}

            {/* Disclaimer legal (Ley 81 / alcance §2.2) */}
            <p class="alert alert-brand text-xs mt-4 font-normal">
              <b>Nota legal:</b> el acuerdo final de adopción se realiza <b>fuera de la
              plataforma</b>. Adopty es un canal de contacto, no gestiona contratos, entregas ni pagos.
            </p>
          </section>
        </div>
      )
    }
  </main>
  <script define:vars={{ petId: pet?.id ?? '', solId: miSolicitud?.id ?? '' }}>
    const solForm = document.getElementById('solForm');
    if (solForm) solForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('solErr');
      const btn = document.getElementById('solBtn');
      err.classList.add('hidden');
      if (!solForm.reportValidity()) return;
      const mensaje = new FormData(solForm).get('mensaje');
      btn.disabled = true;
      btn.textContent = 'Enviando…';
      const res = await fetch('/api/solicitudes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_mascota: petId, mensaje_inicial: mensaje }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) { location.href = `/login?next=${encodeURIComponent(`/mascota/${petId}`)}`; return; }
      if (!res.ok) {
        err.textContent = data.error || 'Error al solicitar';
        err.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Solicitar adopción';
        return;
      }
      // Analytics de embudo: solicitud enviada
      window.adoptyTrack?.('solicitar', { mascota: petId });
      location.reload();
    });
    const solCancel = document.getElementById('solCancel');
    if (solCancel) solCancel.addEventListener('click', async () => {
      if (!confirm('¿Cancelar tu solicitud?')) return;
      const res = await fetch(`/api/solicitudes/${solId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accion: 'cancelar' }),
      });
      if (res.ok) location.reload();
      else alert('No se pudo cancelar');
    });
  </script>
  <script>
    const carousel = document.getElementById('carousel');
    if (carousel) {
      const slides = [...carousel.querySelectorAll('.slide')];
      const dots = [...carousel.querySelectorAll('[data-dot]')];
      const counter = document.getElementById('counter');
      let actual = 0;
      const mostrar = (n) => {
        actual = (n + slides.length) % slides.length;
        slides.forEach((s, i) => (s.style.display = i === actual ? 'block' : 'none'));
        dots.forEach((d, i) => (d.style.background = i === actual ? '#FF6B35' : 'rgba(255,255,255,.75)'));
        if (counter) counter.textContent = `Foto ${actual + 1} / ${slides.length}`;
      };
      document.getElementById('prev')?.addEventListener('click', () => mostrar(actual - 1));
      document.getElementById('next')?.addEventListener('click', () => mostrar(actual + 1));
      dots.forEach((d) => d.addEventListener('click', () => mostrar(Number(d.dataset.dot))));
      carousel.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); mostrar(actual - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); mostrar(actual + 1); }
      });
    }

    // Reportar publicación (formulario en <details>, sin prompt bloqueante)
    const reportForm = document.getElementById('reportForm');
    if (reportForm) {
      const msg = document.getElementById('reportMsg');
      reportForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const motivo = String(new FormData(reportForm).get('motivo') ?? '').trim();
        if (motivo.length < 10) return;
        const btn = reportForm.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = 'Enviando…';
        try {
          const res = await fetch('/api/reportes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id_mascota: petId, motivo }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Error al reportar');
          if (msg) {
            msg.textContent = 'Reporte enviado. Gracias por mantener segura la plataforma.';
            msg.classList.remove('hidden');
          }
          btn.textContent = '✓ Reportado';
          reportForm.reset();
        } catch (err) {
          if (msg) {
            msg.textContent = err.message;
            msg.classList.remove('hidden');
            msg.classList.replace('alert-ok', 'alert-error');
          }
          btn.disabled = false;
          btn.textContent = 'Enviar reporte';
        }
      });
    }
  </script>
</Layout>

<style>
  /* Controles del carrusel: necesitan contraste sobre cualquier foto */
  .carousel-btn {
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.92);
    color: #1e293b;
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    box-shadow: 0 4px 14px rgb(30 41 59 / 0.25);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .carousel-btn:hover {
    background: #ff6b35;
    color: #fff;
  }
  .dot-nav {
    box-shadow: 0 0 0 2px rgb(30 41 59 / 0.15);
    transition: transform 0.15s ease;
  }
  .dot-nav:hover {
    transform: scale(1.25);
  }
  /* El <details> del reporte no debe romper el ritmo de tarjetas */
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details[open] > summary {
    margin-bottom: 0.25rem;
  }
</style>
