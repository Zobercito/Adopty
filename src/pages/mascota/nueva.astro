---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PetForm from '../../components/PetForm.astro';

if (!Astro.locals.user) return Astro.redirect('/login?next=/mascota/nueva');
---

<Layout title="Adopty — Publicar mascota" description="Publica una mascota en adopción en Adopty.">
  <Navbar />
  <main class="max-w-3xl mx-auto px-4 mt-6">
    <div class="soft-card p-6 sm:p-8">
      <h1 class="font-display font-extrabold text-2xl">Publicar mascota</h1>
      <p class="text-sm mt-1 text-muted">
        1–5 fotos y datos reales. Aparecerá como <b>Disponible</b> en Explorar.
      </p>

      <ul class="mt-4 flex flex-wrap gap-2 text-xs text-muted" aria-label="Requisitos">
        <li class="chip">1–5 fotos</li>
        <li class="chip">Nombre y raza</li>
        <li class="chip">Edad en meses</li>
        <li class="chip">Ubicación</li>
        <li class="chip">Descripción (10+ caracteres)</li>
      </ul>

      <div class="mt-7">
        <PetForm mode="create" />
      </div>

      <p class="text-xs mt-6 text-faint border-t border-line pt-4">
        Al publicar aceptas que el acuerdo final de adopción se realiza <b>fuera de la plataforma</b>.
        Adopty no gestiona contratos ni pagos.
      </p>
    </div>
  </main>
</Layout>