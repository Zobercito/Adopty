---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PetCard from '../components/PetCard.astro';
import { supabaseServer } from '../lib/supabase';
import { buscarMascotas, edadLabel, paramsFrom, type ResultadoBusqueda } from '../lib/mascotas';
import { afinidad, type PerfilEstilo } from '../lib/match';

// Fase 3: SSR con DB (URL compartible reproduce resultados) + refetch client-side
// con skeletons para no recargar la página al filtrar.
const user = Astro.locals.user ?? null;

// Perfil de estilo de vida (Fase 1) → alimenta el match.
let perfil: PerfilEstilo | null = null;
if (user) {
  try {
    const { data } = await supabaseServer(Astro.cookies)
      .from('perfil_estilo_vida')
      .select('ambiente,ninos,especie_pref,ubicacion,energia_pref,otras_mascotas,edad_pref')
      .eq('id_persona', user.id)
      .maybeSingle();
    perfil = (data as PerfilEstilo | null) ?? null;
  } catch {
    perfil = null;
  }
}
const tieneEstilo = !!perfil;
// Modo Match por defecto si hay perfil; "?modo=manual" fuerza los filtros.
const modoManual = Astro.url.searchParams.get('modo') === 'manual';
const enMatch = tieneEstilo && !modoManual;

const b = paramsFrom(Astro.url.searchParams);
if (enMatch) b.pageSize = 60; // en match no paginamos: ranking completo

let resultado: ResultadoBusqueda | null = null;
let errorMsg = '';
try {
  resultado = await buscarMascotas(supabaseServer(Astro.cookies), b);
} catch (e) {
  errorMsg = e instanceof Error ? e.message : 'Error al buscar';
}

// Ranking por afinidad (solo en modo match).
let matchItems: { p: ResultadoBusqueda['items'][number]; afinidad: number }[] = [];
if (enMatch && perfil && resultado) {
  const pf = perfil;
  matchItems = resultado.items
    .map((p) => ({ p, afinidad: afinidad(pf, p) }))
    .sort((a, b) => b.afinidad - a.afinidad);
}

const { especie = '', tamano = '', sexo = '', q = '', orden = 'recientes' } = b;
const pagina = resultado?.page ?? 1;
const paginacionVisible = !!resultado && resultado.totalPages > 1 && !enMatch;
/** Reconstruye la URL de una página conservando los filtros activos. */
const paginaUrl = (n: number) => {
  const sp = new URLSearchParams(Astro.url.searchParams);
  sp.set('page', String(n));
  return `/explorar?${sp}`;
};
// Cuántos filtros hay aplicados (para el contador de la barra móvil).
const filtrosActivos = [q, especie, tamano, sexo, orden !== 'recientes' ? orden : ''].filter(
  Boolean,
).length;
const spec: { val: string; label: string }[] = [
  { val: '', label: 'Todas' },
  { val: 'perro', label: 'Perros' },
  { val: 'gato', label: 'Gatos' },
  { val: 'otro', label: 'Otros' },
];
---
<Layout title="Adopty — Explorar mascotas en Panamá" description="Busca perros, gatos y otras mascotas en adopción por especie, tamaño, ubicación o nombre.">
  <Navbar active="explorar" />
  {
    user && !tieneEstilo && (
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <div class="alert alert-brand flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <span>
            Completa tu perfil de estilo de vida y te mostraremos mascotas elegidas para ti.
          </span>
          <a href="/perfil" class="link whitespace-nowrap">
            Completar perfil →
          </a>
        </div>
      </div>
    )
  }

  {
    enMatch && (
      <div class="max-w-6xl mx-auto px-4 mt-6">
        <div class="flex items-end justify-between flex-wrap gap-3">
          <div>
            <h1 class="font-display font-extrabold text-2xl">Elegidas para ti</h1>
            <p class="text-sm text-muted mt-1">
              Ordenadas por afinidad con tu estilo de vida ({matchItems.length}{' '}
              {matchItems.length === 1 ? 'mascota' : 'mascotas'}).
            </p>
          </div>
          <a href="/explorar?modo=manual" class="link text-sm">
            Buscar con filtros manuales →
          </a>
        </div>

        <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-5 mt-5">
          {matchItems.map(({ p, afinidad: af }) => (
            <PetCard
              id={p.id}
              nombre={p.nombre}
              raza={p.raza}
              sexo={p.sexo}
              tamano={p.tamano}
              ubicacion={p.ubicacion}
              estado={p.estado}
              edadLabel={edadLabel(p.edad_meses)}
              fotos={p.fotos}
              afinidad={af}
            />
          ))}
        </div>

        {matchItems.length === 0 && (
          <div class="soft-card p-10 mt-5 text-center">
            <p class="text-4xl" aria-hidden="true">
              🔍
            </p>
            <p class="text-sm mt-3 text-muted">No hay mascotas disponibles ahora mismo.</p>
          </div>
        )}
      </div>
    )
  }

  {
    !enMatch && (
  <div class="max-w-6xl mx-auto px-4 mt-6 grid lg:grid-cols-[280px_1fr] gap-5">
    <aside class="soft-card h-fit lg:sticky lg:top-24 overflow-hidden" aria-label="Filtros de búsqueda">
      {/*
        En móvil los filtros ocupan ~700px y empujan los resultados fuera de
        pantalla, así que van plegados detrás de una barra. Se resuelve con
        `peer` (checkbox) en vez de JS: sin destellos al cargar ni dependencia.
        A partir de lg la barra desaparece y el contenido se muestra siempre.
      */}
      <input type="checkbox" id="filtros-abrir" class="peer sr-only" />
      <label for="filtros-abrir" class="barra-filtros">
        <span class="font-display font-extrabold">Filtros</span>
        {filtrosActivos > 0 && <span class="badge badge-proceso">{filtrosActivos} activos</span>}
        <span class="ml-auto flex items-center gap-1 text-xs font-bold">
          {filtrosActivos > 0 ? 'Ver resultados' : 'Mostrar'}
          <span class="chevron" aria-hidden="true" />
        </span>
      </label>

      <div class="p-6 pt-1 hidden peer-checked:block lg:block">
        <h2 class="font-display font-extrabold text-lg hidden lg:block">Filtros</h2>
        <form id="filtros" method="get" action="/explorar">
          <label class="label mt-4" for="q">Buscar</label>
          <input id="q" name="q" value={q} class="input-soft mt-1 text-sm" placeholder="Nombre, raza, ubicación..." />

        <p class="label mt-5 mb-2" id="lblEspecie">Especie</p>
        <div class="flex flex-wrap gap-2" role="radiogroup" aria-labelledby="lblEspecie">
          {
            spec.map((s) => (
              <label class="chip">
                <input
                  type="radio"
                  name="especie"
                  value={s.val}
                  class="sr-only"
                  checked={especie === s.val}
                />
                {s.label}
              </label>
            ))
          }
        </div>

        <label class="label mt-5 mb-2" for="tamano">Tamaño</label>
        <select id="tamano" name="tamano" class="input-soft mt-1 text-sm">
          <option value="">Todos</option>
          <option value="Pequeño" selected={tamano === 'Pequeño'}>Pequeño</option>
          <option value="Mediano" selected={tamano === 'Mediano'}>Mediano</option>
          <option value="Grande" selected={tamano === 'Grande'}>Grande</option>
        </select>

        <label class="label mt-5 mb-2" for="sexo">Sexo</label>
        <select id="sexo" name="sexo" class="input-soft mt-1 text-sm">
          <option value="">Todos</option>
          <option value="Macho" selected={sexo === 'Macho'}>Macho</option>
          <option value="Hembra" selected={sexo === 'Hembra'}>Hembra</option>
        </select>

        <label class="label mt-5 mb-2" for="orden">Ordenar</label>
        <select id="orden" name="orden" class="input-soft mt-1 text-sm">
          <option value="recientes" selected={orden === 'recientes'}>Más recientes</option>
          <option value="antiguos" selected={orden === 'antiguos'}>Más antiguos</option>
        </select>

        <button id="aplicar" class="btn-primary w-full mt-6 py-3 text-sm" type="submit">Aplicar filtros</button>
        <a href="/explorar" class="w-full text-xs mt-2 py-2.5 text-muted hover:underline block text-center">
          Limpiar todo
        </a>
      </form>
      <p class="text-xs mt-2 text-faint">La URL se actualiza: cópiala para compartir tu búsqueda.</p>
      </div>
    </aside>

    <main>
      {tieneEstilo && (
        <a href="/explorar" class="link text-xs mb-2 inline-block">← Volver al modo Match</a>
      )}
      <p id="count" class="text-sm text-muted" role="status">
        {errorMsg ? 'Error al buscar' : `${resultado?.total ?? 0} ${resultado?.total === 1 ? 'mascota encontrada' : 'mascotas encontradas'}`}{resultado && resultado.totalPages > 1 ? ` · página ${resultado.page} de ${resultado.totalPages}` : ''}
      </p>

      <!-- Skeleton (Fase 3) mientras llega el fetch de filtros -->
      <div id="skeleton" class="grid sm:grid-cols-2 xl:grid-cols-3 gap-5 mt-4" hidden aria-hidden="true">
        {
          Array.from({ length: 6 }).map(() => (
            <article class="soft-card overflow-hidden">
              <div class="skeleton h-52 rounded-none" />
              <div class="p-5 space-y-3">
                <div class="skeleton h-4 w-3/4" />
                <div class="skeleton h-3 w-1/2" />
                <div class="skeleton h-3 w-2/3" />
              </div>
            </article>
          ))
        }
      </div>

      <div id="grid" class="grid sm:grid-cols-2 xl:grid-cols-3 gap-5 mt-4" aria-busy="false">
        {(resultado?.items ?? []).map((p) => (
          <PetCard
            id={p.id}
            nombre={p.nombre}
            raza={p.raza}
            sexo={p.sexo}
            tamano={p.tamano}
            ubicacion={p.ubicacion}
            estado={p.estado}
            edadLabel={edadLabel(p.edad_meses)}
            fotos={p.fotos}
          />
        ))}
      </div>

      <div id="empty" class={`soft-card p-10 mt-4 text-center ${resultado && resultado.items.length === 0 ? '' : 'hidden'}`}>
        <p class="text-4xl" aria-hidden="true">🔍</p>
        <p class="text-sm mt-3 text-muted" id="emptyMsg">{errorMsg || 'Sin resultados con esos filtros. Prueba limpiar o probar otra combinación.'}</p>
        <a href="/explorar" class="btn-ghost text-sm px-6 py-2.5 mt-5">Limpiar filtros</a>
      </div>

      <!-- La paginación se renderiza en servidor: funciona aunque el JS no cargue -->
      <nav
        id="pager"
        class="flex items-center justify-between gap-3 mt-6"
        aria-label="Paginación"
        hidden={!paginacionVisible}
      >
        <a
          id="prev"
          href={paginaUrl(Math.max(1, pagina - 1))}
          class={`chip ${pagina <= 1 ? 'invisible' : ''}`}
          aria-disabled={pagina <= 1 ? 'true' : undefined}
          >← Anterior</a
        >
        <span id="pageNum" class="text-sm text-muted text-center">
          {resultado && resultado.totalPages > 1
            ? `Página ${pagina} de ${resultado.totalPages}`
            : ''}
        </span>
        <a
          id="next"
          href={paginaUrl(Math.min(resultado?.totalPages ?? 1, pagina + 1))}
          class={`chip ${pagina >= (resultado?.totalPages ?? 1) ? 'invisible' : ''}`}
          aria-disabled={pagina >= (resultado?.totalPages ?? 1) ? 'true' : undefined}
          >Siguiente →</a
        >
      </nav>
    </main>
  </div>
    )
  }

  <script define:vars={{ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL }}>
    const form = document.getElementById('filtros');
    const grid = document.getElementById('grid');
    const skeleton = document.getElementById('skeleton');
    const empty = document.getElementById('empty');
    const emptyMsg = document.getElementById('emptyMsg');
    const count = document.getElementById('count');
    const pager = document.getElementById('pager');
    const prev = document.getElementById('prev');
    const next = document.getElementById('next');
    const pageNum = document.getElementById('pageNum');

    // En Modo Match no se renderizan los filtros: no hay nada que enganchar.
    if (!form || !grid) {
      /* modo match */
    } else {

    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fotoUrl = (p) => (!p ? '' : p.startsWith('/') || p.startsWith('http') ? p : `${supabaseUrl}/storage/v1/object/public/mascotas/${p}`);
    const gradFor = (id) => { let n = 0; for (let i = 0; i < id.length; i++) n = (n + id.charCodeAt(i)) % 6; return `pet-grad-${n + 1}`; };
    const edadLabel = (m) => (m <= 0 ? 'Recién nacido' : m < 12 ? `${m} ${m === 1 ? 'mes' : 'meses'}` : `${Math.floor(m / 12)} ${Math.floor(m / 12) === 1 ? 'año' : 'años'}, ${m % 12 ? `${m % 12} meses` : ''}`.trim());
    const badge = (e) => {
      const cls = e === 'en_proceso' ? ['badge-proceso', '#F59E0B', 'En proceso'] : e === 'adoptada' ? ['badge-adoptada', '#6366F1', 'Adoptada'] : ['badge-disponible', '#10B981', 'Disponible'];
      return `<span class="badge ${cls[0]}"><span class="dot" style="background:${cls[1]}"></span>${cls[2]}</span>`;
    };
    const card = (p) => {
      const principal = [...(p.fotos || [])].sort((a, b) => (a.es_principal === b.es_principal ? a.orden - b.orden : a.es_principal ? -1 : 1))[0];
      const foto = fotoUrl(principal?.url_foto);
      const extra = (p.fotos || []).length - (principal ? 1 : 0);
      const url = p.slug ? `/mascota/${esc(p.slug)}` : `/mascota/${esc(p.id)}`;
      const etiqueta = [edadLabel(p.edad_meses), p.sexo, p.tamano, p.ubicacion].filter(Boolean).map(esc).join(' · ');
      return `<article class="soft-card overflow-hidden card-link">
        <a href="${url}" aria-label="Ver perfil de ${esc(p.nombre)}" class="block relative">
          <div class="pet-photo ${gradFor(p.id)} w-full h-52">${foto ? `<img src="${esc(foto)}" alt="${esc(p.nombre)} - ${esc(p.raza)}" loading="lazy" decoding="async" width="640" height="416" class="absolute inset-0 w-full h-full object-cover" style="object-position:center" onerror="this.remove()">` : ''}${
            extra > 0
              ? `<span class="absolute bottom-3 right-3 text-xs font-bold text-white bg-ink/70 backdrop-blur px-2.5 py-1 rounded-full">+${extra} ${extra === 1 ? 'foto' : 'fotos'}</span>`
              : ''
          }</div>
        </a>
        <div class="p-5">
          <div class="flex items-center justify-between gap-2">${badge(p.estado)}
            <button type="button" data-fav-btn="${esc(p.id)}" data-fav-nombre="${esc(p.nombre)}" aria-label="Guardar ${esc(p.nombre)} en favoritos" aria-pressed="false" title="Guardar en favoritos" class="fav-btn -m-2 p-2 w-10 h-10 shrink-0 flex items-center justify-center rounded-full text-faint hover:bg-brand-soft hover:text-brand"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9A5.6 5.6 0 0 1 12 5.7 5.6 5.6 0 0 1 21.6 12c-2.1 4.4-9.6 9-9.6 9Z"></path></svg></button></div>
          <h3 class="font-display font-bold text-lg mt-2 text-ink">${esc(p.nombre)} <span class="text-sm font-medium text-muted">· ${esc(p.raza)}</span></h3>
          <p class="text-sm mt-1">${etiqueta}</p>
          <div class="flex gap-2 mt-4"><a href="${url}" class="btn-primary text-sm px-5 py-2.5 flex-1">Ver perfil</a></div>
        </div>
      </article>`;
    };

    const estadoForm = () => {
      const fd = new FormData(form);
      const sp = new URLSearchParams();
      for (const [k, v] of fd) if (v) sp.set(k, String(v));
      return sp;
    };
    const pintaPager = (d, sp) => {
      if (d.totalPages <= 1) {
        pager.hidden = true;
        return;
      }
      pager.hidden = false;
      pageNum.textContent = `Página ${d.page} de ${d.totalPages}`;
      const url = (p) => {
        const c = new URLSearchParams(sp);
        c.set('page', String(p));
        return `/explorar?${c}`;
      };
      prev.href = url(Math.max(1, d.page - 1));
      next.href = url(Math.min(d.totalPages, d.page + 1));
      // `invisible` mantiene el hueco y reserva el ancho (no salta el layout)
      const borde = (el, off) => {
        el.classList.toggle('invisible', off);
        el.setAttribute('aria-disabled', String(off));
      };
      borde(prev, d.page <= 1);
      borde(next, d.page >= d.totalPages);
    };

    let cargando = false;
    async function cargar(page, push = true) {
      if (cargando) return;
      cargando = true;
      const sp = estadoForm();
      sp.set('page', String(page));
      if (push) history.pushState({ qs: sp.toString() }, '', `/explorar?${sp}`);
      skeleton.hidden = false;
      grid.hidden = true;
      grid.setAttribute('aria-busy', 'true');
      empty.classList.add('hidden');
      pager.hidden = true;
      try {
        const res = await fetch(`/api/mascotas?${sp}`);
        const d = await res.json();
        if (!res.ok) throw new Error(d.error || 'Error de búsqueda');
        grid.innerHTML = d.items.map(card).join('');
        grid.querySelectorAll('[data-fav-btn]').forEach((b) => window.adoptyFavInit?.(b));
        count.textContent = `${d.total} ${d.total === 1 ? 'mascota encontrada' : 'mascotas encontradas'}${d.totalPages > 1 ? ` · página ${d.page} de ${d.totalPages}` : ''}`;
        // Analytics de embudo: búsqueda
        window.adoptyTrack?.('busqueda', { q: sp.get('q') || '', resultados: d.total });
        if (d.items.length === 0) {
          emptyMsg.textContent = 'Sin resultados con esos filtros. Prueba limpiar o probar otra combinación.';
          empty.classList.remove('hidden');
        }
        pintaPager(d, sp);
      } catch (e) {
        emptyMsg.textContent = e.message || 'Error al buscar';
        empty.classList.remove('hidden');
        count.textContent = 'Error al buscar';
      } finally {
        skeleton.hidden = true;
        grid.hidden = false;
        grid.setAttribute('aria-busy', 'false');
        cargando = false;
      }
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); cargar(1); });
    // Cualquier cambio de control (select o chip de especie) reaplica al vuelo.
    form.querySelectorAll('select, input[type="radio"]').forEach((c) =>
      c.addEventListener('change', () => form.requestSubmit())
    );
    pager.addEventListener('click', (e) => {
      const a = e.target.closest('a');
      if (!a) return;
      e.preventDefault();
      cargar(Number(new URL(a.href).searchParams.get('page') || 1));
    });
    window.addEventListener('popstate', () => {
      const sp = new URLSearchParams(location.search);
      for (const el of form.elements) {
        if (!el.name) continue;
        const val = sp.get(el.name) ?? '';
        if (el.type === 'radio' || el.type === 'checkbox') el.checked = el.value === val;
        else el.value = val;
      }
      cargar(Number(sp.get('page') || 1), false);
    });

    // Al aplicar o limpiar filtros en móvil, la barra se pliega sola para no
    // tapar los resultados que acaba de recargar.
    const barra = document.getElementById('filtros-abrir');
    form.addEventListener('submit', () => {
      if (barra && !window.matchMedia('(min-width: 1024px)').matches) barra.checked = false;
    });
    document.querySelector('aside a[href="/explorar"]')?.addEventListener('click', () => {
      if (barra && !window.matchMedia('(min-width: 1024px)').matches) barra.checked = false;
    });
    }
  </script>
</Layout>

<style>
  /* Barra plegable de filtros.
     El `display` se declara aquí y no con `lg:hidden` en el marcado: una regla
     de componente gana por orden de cascada al utility de Tailwind, y la barra
     se colaba también en escritorio. */
  .barra-filtros {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 3.25rem;
    padding: 0.85rem 1.25rem;
    cursor: pointer;
    color: #1e293b;
    font-size: 1rem;
    transition: background-color 0.15s ease;
  }
  .barra-filtros:hover {
    background: #f8fafc;
  }
  @media (min-width: 1024px) {
    .barra-filtros {
      display: none;
    }
  }
  .barra-filtros .chevron {
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: 45deg;
    translate: 0 -2px;
    transition: rotate 0.2s ease;
  }
  /* Abierta → la flecha apunta hacia arriba */
  #filtros-abrir:checked + .barra-filtros .chevron {
    rotate: -135deg;
    translate: 0 2px;
  }
  /* El foco del checkbox (sr-only) debe verse en la barra, no desaparecer */
  #filtros-abrir:focus-visible + .barra-filtros {
    outline: 3px solid #00a8e8;
    outline-offset: -3px;
  }
</style>
