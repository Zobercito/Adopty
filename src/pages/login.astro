---
export const prerender = false;
import { googleActivo } from '../lib/oauth';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

if (Astro.locals.user) return Astro.redirect('/perfil');
const next = Astro.url.searchParams.get('next') ?? '/perfil';
const errorParam = Astro.url.searchParams.get('error');
const oauthMsg = Astro.url.searchParams.get('msg') ?? '';
---

<Layout title="Adopty — Entrar">
  <Navbar />
  <main class="max-w-md mx-auto px-4 mt-8">
    <div class="soft-card p-7 sm:p-8">
      <div class="text-center mb-6">
        <img
          src="/brand/adopty-logo-full-sm.png"
          alt="Adopty"
          width="433"
          height="460"
          class="h-32 w-auto mx-auto"
        />
        <h1 class="font-display font-extrabold text-2xl mt-3">Inicia sesión</h1>
        <p class="text-sm mt-1 text-muted">
          ¿Sin cuenta? <a href="/register?tipo=persona" class="link">Regístrate</a>
        </p>
      </div>

      {errorParam === 'callback' && (
        <p class="alert alert-error mt-4" role="alert">
          El enlace expiró o es inválido. Intenta de nuevo.
        </p>
      )}
      {errorParam === 'oauth' && (
        <p class="alert alert-error mt-4" role="alert">
          {oauthMsg || 'Google no disponible en este entorno.'}
        </p>
      )}
      <p id="err" class="alert alert-error mt-4 hidden" role="alert" />

      {
        googleActivo && (
          <>
            <a
              href={`/api/auth/google?next=${encodeURIComponent(next)}`}
              class="btn-ghost w-full py-2.5 text-sm mt-5"
              aria-label="Entrar con Google"
            >
              <span aria-hidden="true">G&nbsp;</span>Entrar con Google
            </a>
            <div class="flex items-center gap-3 mt-5" aria-hidden="true">
              <hr class="flex-1 border-line" />
              <span class="text-xs text-faint">o con correo</span>
              <hr class="flex-1 border-line" />
            </div>
          </>
        )
      }

      <form id="loginForm" class="mt-5 grid gap-4">
        <div>
          <label class="label" for="correo">Correo</label>
          <input
            id="correo"
            name="correo"
            type="email"
            required
            autocomplete="email"
            autocapitalize="none"
            spellcheck="false"
            class="input-soft mt-1 text-sm"
          />
        </div>
        <div>
          <label class="label" for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="input-soft mt-1 text-sm"
          />
        </div>
        <button id="loginBtn" class="btn-primary py-3 text-sm" type="submit">Entrar</button>
      </form>

      <p class="text-sm mt-5 text-center">
        <a href="/recuperar" class="link-suave">¿Olvidaste tu contraseña?</a>
      </p>
    </div>
  </main>

  <script define:vars={{ next }}>
    const form = document.getElementById('loginForm');
    const err = document.getElementById('err');
    const btn = document.getElementById('loginBtn');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      if (!form.reportValidity()) return;
      const fd = new FormData(form);
      btn.disabled = true;
      btn.textContent = 'Entrando…';
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ correo: fd.get('correo'), password: fd.get('password'), next }),
        });
        if (res.redirected) {
          location.href = res.url;
          return;
        }
        const data = await res.json().catch(() => ({}));
        err.textContent = data.error ?? 'Error al entrar';
        err.classList.remove('hidden');
      } catch {
        err.textContent = 'No se pudo conectar. Revisa tu red e intenta de nuevo.';
        err.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Entrar';
      }
    });
  </script>
</Layout>