---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Adopty — Sin conexión"
  description="No hay conexión a internet. Vuelve a intentarlo cuando recuperes la señal."
>
  <main class="max-w-xl mx-auto px-4 py-24 text-center">
    <svg
      width="64"
      height="64"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="mx-auto text-brand"
      aria-hidden="true"
    >
      <path d="M2 2l20 20"></path>
      <path d="M8.5 16.5a5 5 0 0 1 7 0"></path>
      <path d="M5 12.5a10 10 0 0 1 4-2.4"></path>
      <path d="M15 10.1a10 10 0 0 1 4 2.4"></path>
      <path d="M2 8.8a15 15 0 0 1 5.4-3"></path>
      <path d="M16.6 5.8A15 15 0 0 1 22 8.8"></path>
      <circle cx="12" cy="20" r="1"></circle>
    </svg>
    <h1 class="font-display font-extrabold text-3xl mt-5">Sin conexión</h1>
    <p class="text-sm mt-3 text-muted">
      No pudimos cargar esta página. Revisa tu conexión e inténtalo de nuevo.
    </p>
    <a href="/" class="btn-primary text-sm px-6 py-3 mt-6">Volver al inicio</a>
  </main>
</Layout>
