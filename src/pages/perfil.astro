---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { supabaseServer } from '../lib/supabase';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/perfil');

const supabase = supabaseServer(Astro.cookies);
const { data: perfil } = await supabase.from('usuarios').select('tipo_usuario, correo').eq('id', user.id).single();
const tipo = perfil?.tipo_usuario ?? 'persona';
const esOrg = tipo === 'organizacion';

let detalle: Record<string, string | boolean | null> = {};
let verificada = false;
if (esOrg) {
  const { data } = await supabase
    .from('organizaciones')
    .select('nombre_oficial, direccion, descripcion, sitio_web, verificada')
    .eq('id', user.id)
    .single();
  detalle = data ?? {};
  verificada = Boolean((data as { verificada?: boolean } | null)?.verificada);
} else {
  const { data } = await supabase.from('personas').select('nombre, telefono, descripcion').eq('id', user.id).single();
  detalle = data ?? {};
}

// Última solicitud de verificación: así la organización sabe en qué quedó y,
// si fue rechazada, por qué. La nota la escribe el admin en el panel.
// La RLS deja a cada organización leer sus propias verificaciones.
let verificacion: { estado: string; notas_admin: string | null } | null = null;
if (esOrg) {
  const { data: v } = await supabase
    .from('verificaciones_org')
    .select('estado,notas_admin')
    .eq('id_organizacion', user.id)
    .order('fecha_solicitud', { ascending: false })
    .limit(1)
    .maybeSingle();
  verificacion = (v as typeof verificacion) ?? null;
}
const ESTADO_VERIF: Record<string, string> = {
  pendiente: 'En revisión por el equipo',
  aprobada: 'Verificada',
  rechazada: 'Rechazada',
};

const nombre = (detalle.nombre as string) ?? (detalle.nombre_oficial as string) ?? user.email?.split('@')[0] ?? 'Usuario';
---

<Layout title="Adopty — Mi perfil">
  <Navbar />
  <main class="max-w-xl mx-auto px-4 mt-8">
    <div class="soft-card p-6 sm:p-8">
      <div class="flex items-center gap-4">
        <span class="avatar w-14 h-14 text-xl" aria-hidden="true">{nombre.charAt(0).toUpperCase()}</span>
        <div class="min-w-0">
          <h1 class="font-display font-extrabold text-2xl truncate">{nombre}</h1>
          <p class="text-sm text-muted truncate">
            {perfil?.correo} · {esOrg ? 'Organización' : 'Persona'}
            {esOrg && (verificada ? ' · ✓ Verificada' : ' · pendiente de verificación')}
          </p>
        </div>
      </div>

      <p id="err" class="alert alert-error mt-4 hidden" role="alert" />
      <p id="ok" class="alert alert-ok mt-4 hidden" role="status" />

      <!-- ---------- Datos de perfil ---------- -->
      <h2 class="font-display font-bold text-base mt-7 mb-3">Datos del perfil</h2>
      {
        esOrg ? (
          <form id="perfForm" class="grid gap-4" data-org="1">
            <div>
              <label class="label" for="nombre_oficial">
                Nombre oficial
              </label>
              <input
                id="nombre_oficial"
                name="nombre_oficial"
                required
                minlength="2"
                maxlength="120"
                value={detalle.nombre_oficial as string ?? ''}
                class="input-soft mt-1 text-sm"
              />
            </div>
            <div>
              <label class="label" for="direccion">
                Dirección
              </label>
              <input
                id="direccion"
                name="direccion"
                required
                maxlength="200"
                value={detalle.direccion as string ?? ''}
                class="input-soft mt-1 text-sm"
              />
            </div>
            <div>
              <label class="label" for="sitio_web">
                Sitio web <span class="font-normal normal-case">(opcional)</span>
              </label>
              <input
                id="sitio_web"
                name="sitio_web"
                type="url"
                maxlength="200"
                placeholder="https://"
                value={detalle.sitio_web as string ?? ''}
                class="input-soft mt-1 text-sm"
              />
            </div>
            <div>
              <label class="label" for="descripcion">
                Descripción
              </label>
              <textarea
                id="descripcion"
                name="descripcion"
                maxlength="1000"
                rows="3"
                class="input-soft mt-1 text-sm"
              >
                {detalle.descripcion as string ?? ''}
              </textarea>
            </div>
            <button id="perfBtn" class="btn-primary py-3 text-sm" type="submit">
              Guardar cambios
            </button>
          </form>
        ) : (
          <form id="perfForm" class="grid gap-4">
            <div>
              <label class="label" for="nombre">
                Nombre
              </label>
              <input
                id="nombre"
                name="nombre"
                required
                minlength="2"
                maxlength="80"
                autocomplete="name"
                value={detalle.nombre as string ?? ''}
                class="input-soft mt-1 text-sm"
              />
            </div>
            <div>
              <label class="label" for="telefono">
                Teléfono <span class="font-normal normal-case">(opcional, nunca se muestra en público)</span>
              </label>
              <input
                id="telefono"
                name="telefono"
                type="tel"
                maxlength="20"
                inputmode="tel"
                value={detalle.telefono as string ?? ''}
                class="input-soft mt-1 text-sm"
              />
            </div>
            <div>
              <label class="label" for="descripcion">
                Descripción
              </label>
              <textarea
                id="descripcion"
                name="descripcion"
                maxlength="500"
                rows="3"
                class="input-soft mt-1 text-sm"
              >
                {detalle.descripcion as string ?? ''}
              </textarea>
            </div>
            <button id="perfBtn" class="btn-primary py-3 text-sm" type="submit">
              Guardar cambios
            </button>
          </form>
        )
      }

      <!-- ---------- Verificación de organización ---------- -->
      {
        !verificada && esOrg && !verificacion && (
          <section class="mt-6 p-4 rounded-2xl bg-info-soft border border-sky-200" aria-labelledby="t-verif">
            <h2 id="t-verif" class="text-sm font-bold text-info">
              ¿Quieres el badge «verificada»?
            </h2>
            <p class="text-xs mt-1 text-body">
              Envíanos evidencia de tu organización (redes sociales, documento o sitio web). Lo revisa
              el equipo a mano.
            </p>
            <button id="verifBtn" type="button" class="btn-primary text-xs px-4 py-2 mt-3">
              Solicitar verificación
            </button>
            <p id="verifMsg" class="alert alert-ok text-xs mt-3 hidden" role="status" />
          </section>
        )
      }

      <!-- ---------- Estado de la verificación (con la nota del equipo) ---------- -->
      {
        esOrg && verificacion && (
          <section class="mt-6 p-4 rounded-2xl bg-info-soft border border-sky-200" aria-labelledby="t-verif-est">
            <h2 id="t-verif-est" class="text-sm font-bold text-info">
              Verificación: {ESTADO_VERIF[verificacion.estado] ?? verificacion.estado}
            </h2>
            {verificacion.notas_admin && (
              <p class="text-xs mt-1 text-body">
                <b>Nota del equipo:</b> {verificacion.notas_admin}
              </p>
            )}
            {verificacion.estado === 'rechazada' && (
              <button id="verifBtn" type="button" class="btn-primary text-xs px-4 py-2 mt-3">
                Enviar nueva evidencia
              </button>
            )}
            <p id="verifMsg" class="alert alert-ok text-xs mt-3 hidden" role="status" />
          </section>
        )
      }

      <!-- ---------- Cambio de contraseña ---------- -->
      <section class="mt-6 border-t border-line pt-5">
        <details>
          <summary class="font-display font-bold text-base cursor-pointer hover:text-brand-dark py-2">
            Cambiar contraseña
          </summary>
          <form id="passForm" class="mt-4 grid gap-4" novalidate>
            <div>
              <label class="label" for="p-actual">
                Contraseña actual
              </label>
              <input
                id="p-actual"
                name="actual"
                type="password"
                required
                autocomplete="current-password"
                class="input-soft mt-1 text-sm"
              />
            </div>
            <div>
              <label class="label" for="p-nueva">
                Nueva contraseña
              </label>
              <input
                id="p-nueva"
                name="nueva"
                type="password"
                required
                minlength="8"
                maxlength="72"
                autocomplete="new-password"
                class="input-soft mt-1 text-sm"
                aria-describedby="p-ayuda"
              />
              <p id="p-ayuda" class="text-xs mt-1 text-faint">Mínimo 8 caracteres.</p>
            </div>
            <div>
              <label class="label" for="p-confirmar">
                Repite la nueva contraseña
              </label>
              <input
                id="p-confirmar"
                name="confirmar"
                type="password"
                required
                minlength="8"
                maxlength="72"
                autocomplete="new-password"
                class="input-soft mt-1 text-sm"
              />
            </div>
            <button class="btn-primary py-2.5 text-sm" type="submit">Actualizar contraseña</button>
            <p id="passErr" class="alert alert-error hidden" role="alert" />
            <p id="passOk" class="alert alert-ok hidden" role="status" />
          </form>
        </details>
      </section>

      <!-- ---------- Sesión ---------- -->
      <section class="mt-6 border-t border-line pt-5">
        <h2 class="font-display font-bold text-base">Sesión</h2>
        <p class="text-xs text-muted mt-1">Al cerrar sesión solo sales de este dispositivo.</p>
        <form action="/api/auth/logout" method="post" class="mt-3">
          <button class="btn-ghost w-full py-2.5 text-sm" type="submit">Cerrar sesión</button>
        </form>
      </section>
    </div>
  </main>

  <script>
    // ---------- Perfil ----------
    const perfForm = document.getElementById('perfForm');
    const err = document.getElementById('err');
    const ok = document.getElementById('ok');
    const perfBtn = document.getElementById('perfBtn');
    perfForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      ok.classList.add('hidden');
      if (!perfForm.reportValidity()) return;
      const fd = new FormData(perfForm);
      const isOrg = perfForm.hasAttribute('data-org');
      const payload = isOrg
        ? {
            nombre_oficial: fd.get('nombre_oficial'),
            direccion: fd.get('direccion'),
            sitio_web: fd.get('sitio_web'),
            descripcion: fd.get('descripcion'),
          }
        : { nombre: fd.get('nombre'), telefono: fd.get('telefono'), descripcion: fd.get('descripcion') };
      perfBtn.disabled = true;
      const previo = perfBtn.textContent;
      perfBtn.textContent = 'Guardando…';
      try {
        const res = await fetch('/api/perfil', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          err.textContent = data.error ?? 'Error al guardar';
          err.classList.remove('hidden');
          return;
        }
        ok.textContent = 'Perfil actualizado.';
        ok.classList.remove('hidden');
      } catch {
        err.textContent = 'No se pudo conectar. Revisa tu red e intenta de nuevo.';
        err.classList.remove('hidden');
      } finally {
        perfBtn.disabled = false;
        perfBtn.textContent = previo;
      }
    });

    // ---------- Cambio de contraseña ----------
    const passForm = document.getElementById('passForm');
    passForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const passErr = document.getElementById('passErr');
      const passOk = document.getElementById('passOk');
      passErr.classList.add('hidden');
      passOk.classList.add('hidden');
      const fd = new FormData(passForm);
      const payload = { actual: fd.get('actual'), nueva: fd.get('nueva'), confirmar: fd.get('confirmar') };
      // Comprobación temprana: no gastar un intento del servidor si no coinciden.
      if (payload.nueva !== payload.confirmar) {
        passErr.textContent = 'Las contraseñas nuevas no coinciden.';
        passErr.classList.remove('hidden');
        return;
      }
      const btn = passForm.querySelector('button[type="submit"]');
      const previo = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Actualizando…';
      try {
        const res = await fetch('/api/auth/cambiar-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          passErr.textContent = data.error ?? 'No se pudo cambiar la contraseña';
          passErr.classList.remove('hidden');
          return;
        }
        passForm.reset();
        passOk.textContent = 'Contraseña actualizada. Las otras sesiones se cerraron.';
        passOk.classList.remove('hidden');
      } catch {
        passErr.textContent = 'No se pudo conectar. Revisa tu red e intenta de nuevo.';
        passErr.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = previo;
      }
    });

    // ---------- Verificación (formulario en vez de prompt()) ----------
    const verifBtn = document.getElementById('verifBtn');
    const TIPOS = [
      ['redes_sociales', 'Redes sociales'],
      ['documento', 'Documento'],
      ['sitio_web', 'Sitio web'],
      ['otro', 'Otro'],
    ];
    if (verifBtn) {
      const box = document.createElement('form');
      box.className = 'mt-3 grid gap-3';
      box.innerHTML = `
        <div>
          <label class="label" for="v-tipo">Tipo de evidencia</label>
          <select id="v-tipo" class="input-soft mt-1 text-sm">
            ${TIPOS.map(([v, l]) => `<option value="${v}">${l}</option>`).join('')}
          </select>
        </div>
        <div>
          <label class="label" for="v-url">URL de la evidencia</label>
          <input id="v-url" type="url" required placeholder="https://" class="input-soft mt-1 text-sm" />
        </div>
        <div>
          <label class="label" for="v-desc">Descripción <span class="font-normal normal-case">(opcional)</span></label>
          <input id="v-desc" maxlength="500" class="input-soft mt-1 text-sm" />
        </div>
        <button type="submit" class="btn-primary text-xs px-4 py-2 justify-self-start">Enviar solicitud</button>`;
      verifBtn.replaceWith(box);
      box.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = document.getElementById('verifMsg');
        const btn = box.querySelector('button[type="submit"]');
        const payload = {
          tipo_evidencia: box.querySelector('#v-tipo').value,
          url_evidencia: box.querySelector('#v-url').value,
          descripcion: box.querySelector('#v-desc').value,
        };
        if (!payload.url_evidencia.startsWith('http')) {
          msg.textContent = 'La URL debe comenzar con http';
          msg.classList.remove('hidden');
          msg.classList.replace('alert-ok', 'alert-error');
          return;
        }
        btn.disabled = true;
        btn.textContent = 'Enviando…';
        try {
          const res = await fetch('/api/verificacion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Error al enviar');
          msg.textContent = 'Solicitud enviada. Te notificaremos cuando sea revisada.';
          msg.classList.remove('hidden');
          msg.classList.replace('alert-error', 'alert-ok');
          box.reset();
        } catch (err) {
          msg.textContent = err.message;
          msg.classList.remove('hidden');
          msg.classList.replace('alert-ok', 'alert-error');
          btn.disabled = false;
          btn.textContent = 'Enviar solicitud';
        }
      });
    }
  </script>
</Layout>

<style>
  details > summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  /* Chevron dibujado con CSS: no añade nodos al DOM */
  details > summary::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: -45deg;
    transition: rotate 0.18s ease;
  }
  details[open] > summary::before {
    rotate: 45deg;
  }
</style>