---
export const prerender = false;
import { googleActivo } from '../lib/oauth';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

if (Astro.locals.user) return Astro.redirect('/perfil');

// ?tipo=organizacion preselecciona el tipo de cuenta (p. ej. desde "Registrar mi
// organización"); por defecto es persona.
const tipo = Astro.url.searchParams.get('tipo') === 'organizacion' ? 'organizacion' : 'persona';
const esOrg = tipo === 'organizacion';
---

<Layout title="Adopty — Crear cuenta">
  <Navbar />
  <main class="max-w-md mx-auto px-4 mt-8">
    <div class="soft-card p-7 sm:p-8">
      <div class="text-center mb-6">
        <img
          src="/brand/adopty-logo-full-sm.png"
          alt="Adopty"
          width="433"
          height="460"
          class="h-32 w-auto mx-auto"
        />
        <h1 id="regTitulo" class="font-display font-extrabold text-2xl mt-3">
          {esOrg ? 'Registra tu organización' : 'Crea tu cuenta'}
        </h1>
        <p class="text-sm mt-1 text-muted">¿Ya tienes? <a href="/login" class="link">Entra</a></p>
      </div>

      {
        googleActivo && !esOrg && (
          <>
            <a
              href="/api/auth/google?next=/perfil"
              class="btn-ghost w-full py-2.5 text-sm mt-5"
              aria-label="Registrarme con Google"
            >
              <span aria-hidden="true">G&nbsp;</span>Registrarme con Google
            </a>
            <div class="flex items-center gap-3 mt-5" aria-hidden="true">
              <hr class="flex-1 border-line" />
              <span class="text-xs text-faint">o con correo</span>
              <hr class="flex-1 border-line" />
            </div>
          </>
        )
      }
      {
        googleActivo && esOrg && (
          <p class="text-xs text-muted mt-5 text-center">
            Para registrar una organización hazlo con tu correo: Google crea cuentas personales.
          </p>
        )
      }

      <p id="err" class="alert alert-error mt-5 hidden" role="alert" />
      <p id="ok" class="alert alert-ok mt-5 hidden" role="status" />

      <form id="regForm" class="mt-5 grid gap-4">
        <fieldset>
          <legend class="label">Tipo de cuenta</legend>
          <div class="flex gap-2 mt-2">
            <label class="chip flex-1 justify-center">
              <input type="radio" name="tipo_usuario" value="persona" checked={!esOrg} class="accent-brand" /> Persona
            </label>
            <label class="chip flex-1 justify-center">
              <input type="radio" name="tipo_usuario" value="organizacion" checked={esOrg} class="accent-brand" />
              Organización
            </label>
          </div>
        </fieldset>

        <div>
          <label class="label" id="nombreLabel" for="nombre">{esOrg ? 'Organización' : 'Nombre'}</label>
          <input
            id="nombre"
            name="nombre"
            required
            minlength="2"
            maxlength="80"
            autocomplete={esOrg ? 'organization' : 'name'}
            placeholder={esOrg ? 'Nombre de la organización' : 'Tu nombre'}
            class="input-soft mt-1 text-sm"
          />
        </div>
        <div>
          <label class="label" for="correo">Correo</label>
          <input
            id="correo"
            name="correo"
            type="email"
            required
            autocomplete="email"
            autocapitalize="none"
            spellcheck="false"
            class="input-soft mt-1 text-sm"
          />
        </div>
        <div>
          <label class="label" for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            minlength="8"
            autocomplete="new-password"
            class="input-soft mt-1 text-sm"
            aria-describedby="pwdHint"
          />
          <p id="pwdHint" class="text-xs mt-1 text-faint">Mínimo 8 caracteres.</p>
        </div>

        <label class="flex items-start gap-2.5 text-xs text-muted leading-relaxed">
          <input type="checkbox" required class="mt-0.5 accent-brand w-4 h-4 shrink-0" />
          <span>
            Acepto el <a href="/privacidad" class="link" target="_blank" rel="noopener">aviso de privacidad</a>
            y el uso de mi correo y ubicación para fines de adopción (Ley 81 de Protección de Datos de
            Panamá).
          </span>
        </label>

        <button id="regBtn" class="btn-primary py-3 text-sm" type="submit">Registrarme</button>
      </form>
    </div>
  </main>

  <script>
    const form = document.getElementById('regForm');
    const err = document.getElementById('err');
    const ok = document.getElementById('ok');
    const btn = document.getElementById('regBtn');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      ok.classList.add('hidden');
      if (!form.reportValidity()) return;
      const fd = new FormData(form);
      btn.disabled = true;
      btn.textContent = 'Creando cuenta…';
      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nombre: fd.get('nombre'),
            correo: fd.get('correo'),
            password: fd.get('password'),
            tipo_usuario: fd.get('tipo_usuario'),
          }),
        });
        if (res.redirected) {
          location.href = res.url;
          return;
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          err.textContent = data.error ?? 'Error al registrar';
          err.classList.remove('hidden');
          return;
        }
        if (data.confirmaEmail) {
          ok.textContent = 'Revisa tu correo para confirmar la cuenta y luego entra.';
          ok.classList.remove('hidden');
        }
      } catch {
        err.textContent = 'No se pudo conectar. Revisa tu red e intenta de nuevo.';
        err.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Registrarme';
      }
    });

    // Título y etiqueta dinámicos según el tipo de cuenta elegido.
    const regTitulo = document.getElementById('regTitulo');
    const nombreLabel = document.getElementById('nombreLabel');
    const nombreInput = document.getElementById('nombre');
    const sincronizar = () => {
      const org =
        document.querySelector('input[name="tipo_usuario"]:checked')?.value === 'organizacion';
      if (regTitulo) regTitulo.textContent = org ? 'Registra tu organización' : 'Crea tu cuenta';
      if (nombreLabel) nombreLabel.textContent = org ? 'Organización' : 'Nombre';
      if (nombreInput) {
        nombreInput.placeholder = org ? 'Nombre de la organización' : 'Tu nombre';
        nombreInput.autocomplete = org ? 'organization' : 'name';
      }
    };
    document.querySelectorAll('input[name="tipo_usuario"]').forEach((r) => {
      r.addEventListener('change', sincronizar);
    });
    sincronizar();
  </script>
</Layout>