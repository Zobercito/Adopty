---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

if (Astro.locals.user) return Astro.redirect('/perfil');
---
<Layout title="Adopty — Crear cuenta">
  <Navbar active="inicio" />
  <main class="max-w-md mx-auto px-4 mt-10">
    <div class="soft-card p-8">
      <h1 class="font-display font-extrabold text-2xl" style="color:#1E293B">Crear cuenta</h1>
      <p class="text-sm mt-1">¿Ya tienes? <a href="/login" class="font-bold" style="color:#14A098">Entra</a></p>
      <a href="/api/auth/google?next=/perfil" class="btn-ghost w-full py-2.5 text-sm mt-4 block text-center" aria-label="Registrarme con Google">
        <span aria-hidden="true">G&nbsp;</span>Registrarme con Google
      </a>
      <div class="flex items-center gap-3 mt-4" aria-hidden="true"><hr class="flex-1 border-gray-200" /><span class="text-xs text-gray-400">o con correo</span><hr class="flex-1 border-gray-200" /></div>
      <p id="err" class="text-sm mt-3 font-semibold hidden" style="color:#B45309" role="alert"></p>
      <p id="ok" class="text-sm mt-3 font-semibold hidden" style="color:#065F46" role="status"></p>
      <form id="regForm" class="mt-5 grid gap-3">
        <div>
          <label class="text-xs font-bold uppercase tracking-wide" for="nombre">Nombre / Organización</label>
          <input id="nombre" name="nombre" required minlength="2" maxlength="80" autocomplete="name" class="input-soft mt-1 text-sm" />
        </div>
        <div>
          <label class="text-xs font-bold uppercase tracking-wide" for="correo">Correo</label>
          <input id="correo" name="correo" type="email" required autocomplete="email" class="input-soft mt-1 text-sm" />
        </div>
        <div>
          <label class="text-xs font-bold uppercase tracking-wide" for="password">Contraseña (mín. 8)</label>
          <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" class="input-soft mt-1 text-sm" />
        </div>
        <fieldset>
          <legend class="text-xs font-bold uppercase tracking-wide">Tipo de cuenta</legend>
          <div class="flex gap-2 mt-2">
            <label class="chip cursor-pointer"><input type="radio" name="tipo_usuario" value="persona" checked class="accent-orange-500" /> Persona</label>
            <label class="chip cursor-pointer"><input type="radio" name="tipo_usuario" value="organizacion" class="accent-orange-500" /> Organización</label>
          </div>
        </fieldset>
        <label class="flex items-start gap-2 text-xs mt-1">
          <input type="checkbox" required class="mt-0.5 accent-orange-500" />
          <span>Acepto el <a href="/privacidad" class="font-bold underline" target="_blank">aviso de privacidad</a> y el uso de mi correo y ubicación para fines de adopción (Ley 81 de Protección de Datos de Panamá).</span>
        </label>
        <button class="btn-primary py-3 text-sm mt-2" type="submit">Registrarme</button>
      </form>
    </div>
  </main>
  <script>
    document.getElementById('regForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('err'), ok = document.getElementById('ok');
      err.classList.add('hidden'); ok.classList.add('hidden');
      const fd = new FormData(e.target);
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre: fd.get('nombre'), correo: fd.get('correo'), password: fd.get('password'), tipo_usuario: fd.get('tipo_usuario') }),
      });
      if (res.redirected) { location.href = res.url; return; }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { err.textContent = data.error ?? 'Error al registrar'; err.classList.remove('hidden'); return; }
      if (data.confirmaEmail) { ok.textContent = 'Revisa tu correo para confirmar la cuenta y luego entra.'; ok.classList.remove('hidden'); }
    });
  </script>
</Layout>
