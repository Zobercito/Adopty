---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { supabaseServer } from '../lib/supabase';
import { fechaCorta, getMisSolicitudes, solBadge } from '../lib/solicitudes';

if (!Astro.locals.user) return Astro.redirect('/login?next=/mis-solicitudes');
const supabase = supabaseServer(Astro.cookies);
let lista: Awaited<ReturnType<typeof getMisSolicitudes>> = [];
let errorMsg = '';
try {
  lista = await getMisSolicitudes(supabase, Astro.locals.user.id);
} catch (e) {
  errorMsg = e instanceof Error ? e.message : 'Error al cargar';
}
const abiertas = lista.filter((s) => s.estado === 'pendiente').length;
const creadas = lista.length;
---

<Layout title="Adopty — Mis solicitudes de adopción">
  <Navbar />
  <main class="max-w-4xl mx-auto px-4 mt-6">
    <div class="flex items-end justify-between flex-wrap gap-3">
      <div>
        <h1 class="font-display font-extrabold text-2xl">Mis solicitudes</h1>
        <p class="text-sm mt-1 text-muted">
          Pendiente → Aprobada / Rechazada / Cancelada. Te avisamos aquí mismo cuando cambien.
        </p>
      </div>
      <a href="/panel/solicitudes" class="link text-sm">Ver recibidas →</a>
    </div>

    {
      creadas > 0 && (
        <div class="grid grid-cols-2 gap-4 mt-5 sm:max-w-md">
          <div class="soft-card p-4">
            <p class="font-display font-extrabold text-2xl text-ink tabular">{creadas}</p>
            <p class="text-xs text-muted">En total</p>
          </div>
          <div class="soft-card p-4">
            <p class="font-display font-extrabold text-2xl text-brand tabular">{abiertas}</p>
            <p class="text-xs text-muted">Esperando respuesta</p>
          </div>
        </div>
      )
    }

    {errorMsg && <p class="alert alert-error mt-5" role="alert">{errorMsg}</p>}

    {
      lista.length === 0 && !errorMsg ? (
        <div class="soft-card p-10 mt-6 text-center">
          <p class="text-5xl" aria-hidden="true">
            📝
          </p>
          <h2 class="font-display font-bold text-lg mt-4">Aún no solicitaste ninguna adopción</h2>
          <p class="text-sm mt-2 text-muted">
            Cuando envíes una solicitud, podrás seguir aquí su estado y chatear si se aprueba.
          </p>
          <a href="/explorar" class="btn-primary text-sm px-6 py-2.5 mt-5">
            Explorar mascotas
          </a>
        </div>
      ) : (
        <div class="grid gap-4 mt-6">
          {lista.map((s) => {
            const [cls, dot, etiqueta] = solBadge(s.estado);
            return (
              <article class="soft-card p-4 sm:p-5 flex gap-4">
                <a
                  href={`/mascota/${s.mascota.id}`}
                  class="shrink-0 w-20 h-20 rounded-xl overflow-hidden bg-surface relative block"
                  aria-label={`Ver ${s.mascota.nombre}`}
                >
                  {s.mascota.foto && (
                    <img
                      src={s.mascota.foto}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="80"
                      height="80"
                      class="absolute inset-0 w-full h-full object-cover"
                      onerror="this.remove()"
                    />
                  )}
                </a>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <a href={`/mascota/${s.mascota.id}`} class="font-display font-bold text-ink">
                      {s.mascota.nombre}
                    </a>
                    <span class={`badge ${cls}`}>
                      <span class="dot" style={`background:${dot}`} />
                      {etiqueta}
                    </span>
                    <span class="text-xs text-faint ml-auto tabular">{fechaCorta(s.fecha_solicitud)}</span>
                  </div>
                  <p class="text-xs mt-1 text-muted">
                    {s.mascota.raza} · {s.mascota.ubicacion}
                  </p>
                  <p class="text-sm mt-2 bg-surface rounded-xl p-3 text-muted italic">“{s.mensaje_inicial}”</p>

                  {s.estado === 'pendiente' && (
                    <button
                      type="button"
                      data-cancelar={s.id}
                      class="btn-quiet text-xs px-3 py-1.5 mt-2 -ml-3 text-danger"
                    >
                      Cancelar solicitud
                    </button>
                  )}
                  {s.estado === 'aprobada' && (
                    <p class="alert alert-ok text-xs mt-3">
                      ¡Aprobada! La mascota pasó a En proceso. Coordina la entrega con el publicador.
                    </p>
                  )}
                  {(s.estado === 'rechazada' || s.estado === 'cancelada') && (
                    <p class="text-xs mt-3 text-muted">
                      {s.estado === 'rechazada'
                        ? 'El publicador la rechazó. Puedes volver a solicitarlo más adelante.'
                        : 'Cancelaste esta solicitud.'}
                    </p>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      )
    }
  </main>

  <script>
    document.querySelectorAll('[data-cancelar]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        if (!confirm('¿Cancelar esta solicitud?')) return;
        const id = btn.getAttribute('data-cancelar');
        btn.disabled = true;
        btn.textContent = 'Cancelando…';
        const res = await fetch(`/api/solicitudes/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accion: 'cancelar' }),
        });
        if (res.ok) {
          location.reload();
        } else {
          btn.disabled = false;
          btn.textContent = 'Cancelar solicitud';
          alert('No se pudo cancelar');
        }
      }),
    );
  </script>
</Layout>