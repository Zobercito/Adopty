---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PetCard from '../components/PetCard.astro';
import { supabaseServer } from '../lib/supabase';
import { buscarMascotas, edadLabel, fotoUrl, gradFor, type MascotaRow, type FotoRow } from '../lib/mascotas';
import { PETS } from '../data/mockPets';

type Card = {
  id: string;
  slug?: string;
  nombre: string;
  raza: string;
  sexo: string;
  tamano: string;
  ubicacion: string;
  estado: string;
  edadLabel: string;
  descripcion: string;
  publicador?: string;
  fotos: FotoRow[];
};

const deMock = (p: (typeof PETS)[number]): Card => ({
  id: p.id,
  slug: undefined,
  nombre: p.nombre,
  raza: p.raza,
  sexo: p.sexo,
  tamano: p.tamano,
  ubicacion: p.ubicacion,
  estado: p.estado === 'En proceso' ? 'en_proceso' : p.estado === 'Adoptada' ? 'adoptada' : 'disponible',
  edadLabel: p.edad,
  descripcion: p.personalidad,
  publicador: p.publicador,
  fotos: [{ id_mascota: p.id, url_foto: p.foto, es_principal: true, orden: 0 }],
});

// DB primero (Fase 3); si está vacía o falla, catálogo demo del Fase 0.
let destacadas: Card[] = [];
let hero: Card[] = [];
let conDb = false;
let totalDisponibles = 0;
try {
  const r = await buscarMascotas(supabaseServer(Astro.cookies), { estado: 'disponible', pageSize: 6 });
  destacadas = r.items.map((p: MascotaRow & { fotos: FotoRow[] }) => ({
    id: p.id,
    slug: p.slug,
    nombre: p.nombre,
    raza: p.raza,
    sexo: p.sexo,
    tamano: p.tamano,
    ubicacion: p.ubicacion,
    estado: p.estado,
    edadLabel: edadLabel(p.edad_meses),
    descripcion: p.descripcion,
    fotos: p.fotos,
  }));
  hero = destacadas.slice(0, 4);
  conDb = destacadas.length > 0;
  totalDisponibles = r.total;
} catch {
  conDb = false;
}
if (!conDb) {
  destacadas = PETS.filter((p) => p.estado === 'Disponible').slice(0, 6).map(deMock);
  hero = PETS.slice(0, 4).map(deMock);
  totalDisponibles = 120; // estimación del catálogo demo
}

const user = Astro.locals.user ?? null;

const heroFoto = hero[0] ? fotoUrl(hero[0].fotos[0]?.url_foto) : '';
const heroGrad = hero[0] ? gradFor(hero[0].id) : 'pet-grad-1';

const PASOS = [
  { n: '1', t: 'Llena tu perfil de estilo de vida', d: 'Indica tu espacio, tiempo libre, rutina y presencia de niños o mascotas en casa.', icono: '📝', tono: 'brand' },
  { n: '2', t: 'Recibe mascotas ideales', d: 'El sistema prioriza mascotas con comportamiento y energía compatibles contigo.', icono: '💖', tono: 'sky' },
  { n: '3', t: 'Conecta con el refugio', d: 'Envía tu solicitud directo al publicador con un porcentaje de afinidad respaldado.', icono: '🤝', tono: 'success' },
];

const VALORES = [
  { icono: '🐾', t: 'Bienestar animal', d: 'Cada match prioriza hogares donde la mascota realmente prosperará.' },
  { icono: '🔒', t: 'Sin exponer tus datos', d: 'Chat interno por mascota: tu número y correo nunca se muestran.' },
  { icono: '✅', t: 'Refugios verificados', d: 'Organizaciones y rescatistas con validación dentro de la plataforma.' },
];
---

<Layout title="Adopty — Adopta con amor en Panamá">
  <Navbar active="inicio" />

  <!-- ============ HERO ============ -->
  <section id="inicio" class="snap-sec relative overflow-hidden pt-10 pb-16 lg:pt-16 lg:pb-24">
    <div class="absolute top-0 right-0 w-96 h-96 blob-sky rounded-full -z-10 translate-x-1/3 -translate-y-1/3 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 blob-orange rounded-full -z-10 -translate-x-1/3 translate-y-1/3 blur-3xl" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-10 items-center">
        <div class="space-y-6 text-center lg:text-left">
          <!-- Marca en el hero (se queda fija, no se mueve) -->
          <div id="heroLogo" class="flex items-center justify-center lg:justify-start gap-5 lg:w-full">
            <img
              src="/brand/adopty-logo-icon-sm.png"
              alt=""
              width="376"
              height="300"
              class="h-24 lg:h-[13rem] w-auto shrink-0"
            />
            <img
              src="/brand/adopty-logo-text-sm.png"
              alt="Adopty"
              width="642"
              height="180"
              class="h-8 w-auto lg:h-auto lg:min-w-0 lg:w-full lg:flex-1 lg:object-contain lg:object-left"
            />
          </div>

          <h1 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl leading-tight text-ink">
            Encuentra a la mascota que <span class="text-gradient">encaja con tu vida</span>
          </h1>

          <p class="text-body text-base sm:text-lg max-w-xl mx-auto lg:mx-0 leading-relaxed">
            Adopty es la plataforma que conecta mascotas en adopción con hogares en Panamá. Adoptar es un
            acto de amor
          </p>

          <dl class="pt-6 mt-2 grid grid-cols-3 gap-4 border-t border-line text-center lg:text-left">
            <div>
              <dd class="font-display font-extrabold text-2xl sm:text-3xl text-brand tabular">{conDb ? `${totalDisponibles}+` : '120+'}</dd>
              <dt class="text-xs text-muted font-semibold">Mascotas disponibles</dt>
            </div>
            <div>
              <dd class="font-display font-extrabold text-2xl sm:text-3xl text-teal tabular">+35</dd>
              <dt class="text-xs text-muted font-semibold">Refugios aliados</dt>
            </div>
            <div>
              <dd class="font-display font-extrabold text-2xl sm:text-3xl text-ink tabular">0$</dd>
              <dt class="text-xs text-muted font-semibold">Comisión de Adopty</dt>
            </div>
          </dl>
        </div>

        <!-- Imagen principal + insignias flotantes -->
        <div class="relative mx-auto max-w-md lg:max-w-none w-full">
          <div class="relative z-10 rounded-[2.5rem] overflow-hidden bg-gradient-to-tr from-teal-soft to-brand-soft border-8 border-white shadow-2xl p-4">
            <div class={`pet-photo ${heroGrad} w-full h-80 sm:h-[420px] rounded-[2rem]`}>
              {
                heroFoto && (
                  <img
                    src={heroFoto}
                    alt={hero[0] ? `Foto de ${hero[0].nombre}` : 'Mascota en adopción'}
                    loading="eager"
                    decoding="async"
                    width="800"
                    height="840"
                    class="absolute inset-0 w-full h-full object-cover"
                    onerror="this.remove()"
                  />
                )
              }
            </div>
          </div>

          <div class="float-slow absolute -top-5 -left-5 z-20 bg-white p-3.5 rounded-3xl shadow-xl border border-slate-100 flex items-center gap-3">
            <span class="w-11 h-11 rounded-2xl bg-brand-soft flex items-center justify-center text-brand text-xl" aria-hidden="true">🐾</span>
            <span>
              <span class="block text-[10px] text-faint font-bold uppercase tracking-wide">Publicado por</span>
              <span class="block text-sm font-extrabold text-ink">Refugios verificados</span>
            </span>
          </div>

          <div class="absolute -bottom-5 -right-5 z-20 bg-white p-3.5 rounded-3xl shadow-xl border border-slate-100 flex items-center gap-3">
            <span class="w-11 h-11 rounded-2xl bg-teal-soft flex items-center justify-center text-teal text-xl" aria-hidden="true">🏠</span>
            <span>
              <span class="block text-[10px] text-faint font-bold uppercase tracking-wide">Evaluación</span>
              <span class="block text-sm font-extrabold text-ink">Apto para apartamentos</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BUSCAR + DESTACADAS (una sola pantalla) ===== -->
  <section id="mascotas" class="snap-sec max-w-6xl mx-auto px-4" aria-labelledby="sec-destacadas">
    <!-- Destacadas -->
    <div class="mb-4">
      <h2 id="sec-destacadas" class="font-display font-extrabold text-2xl text-ink">
        Listos para conectar contigo
      </h2>
      <p class="text-xs text-muted mt-1">Mascotas que hoy buscan un hogar en Panamá</p>
    </div>

    <div
      class="carousel"
      id="destacadasCarrusel"
      role="region"
      aria-roledescription="carrusel"
      aria-label="Mascotas destacadas"
    >
      <button type="button" class="carousel-arrow carousel-arrow--prev" id="carrPrev" aria-label="Ver mascotas anteriores">
        <span aria-hidden="true">‹</span>
      </button>

      <div class="carousel-viewport">
        <div class="carousel-track" id="carrTrack">
          {
            destacadas.map((p) => (
              <div class="carousel-item">
                <PetCard
                  id={p.id}
                  slug={p.slug}
                  nombre={p.nombre}
                  raza={p.raza}
                  sexo={p.sexo}
                  tamano={p.tamano}
                  ubicacion={p.ubicacion}
                  estado={p.estado}
                  edadLabel={p.edadLabel}
                  descripcion={p.descripcion}
                  publicador={p.publicador}
                  fotos={p.fotos}
                  compact
                />
              </div>
            ))
          }
        </div>
      </div>

      <button type="button" class="carousel-arrow carousel-arrow--next" id="carrNext" aria-label="Ver más mascotas">
        <span aria-hidden="true">›</span>
      </button>
    </div>

    <div class="mt-6 text-center">
      <a href="/explorar" class="btn-ghost inline-flex items-center gap-2 px-6 py-3 text-sm">
        Explorar todas las mascotas <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ============ CÓMO FUNCIONA ============ -->
  <section id="como-funciona" class="snap-sec bg-gradient-to-b from-white to-slate-50 py-16 lg:py-24 border-y border-line">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-teal font-bold text-xs uppercase tracking-widest">Garantía de adopción responsable</span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-ink mt-2">¿Cómo funciona Adopty?</h2>
        <p class="text-muted text-sm sm:text-base mt-3">
          Diseñado para asegurar la máxima afinidad entre la mascota y tu hogar en 3 simples pasos.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          PASOS.map((p) => (
            <div class="soft-card p-8 text-center lift">
              <span
                class="w-16 h-16 mx-auto rounded-3xl flex items-center justify-center text-2xl mb-6"
                style={p.tono === 'brand' ? 'background:#fff0ea' : p.tono === 'sky' ? 'background:#e6f6ff' : 'background:#ecfdf5'}
                aria-hidden="true"
              >
                {p.icono}
              </span>
              <h3 class="font-display font-extrabold text-xl text-ink mb-2">{p.t}</h3>
              <p class="text-body text-xs sm:text-sm leading-relaxed">{p.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ SOBRE NOSOTROS (solo visitantes) ============ -->
  {
    !user && (
      <section id="nosotros" class="snap-sec max-w-6xl mx-auto px-4 py-10 lg:py-14" aria-labelledby="sec-nosotros">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="text-brand font-bold text-xs uppercase tracking-widest">Sobre nosotros</span>
            <h2 id="sec-nosotros" class="font-display font-extrabold text-3xl sm:text-4xl text-ink mt-2">
              Una plataforma hecha en Panamá para salvar vidas
            </h2>
            <p class="text-body mt-4 leading-relaxed">
              Adopty nace como proyecto de Ingeniería de Software de la Universidad de Panamá con una meta
              simple: reemplazar los estados de WhatsApp y los grupos dispersos por un espacio centralizado,
              seguro y con matching real entre personas y mascotas.
            </p>
            <p class="text-body mt-3 leading-relaxed">
              Conectamos refugios, rescatistas independientes y adoptantes responsables, reduciendo el
              abandono y promoviendo la tenencia responsable en todo el país.
            </p>

            <div class="grid sm:grid-cols-3 gap-4 mt-8">
              {
                VALORES.map((v) => (
                  <div class="soft-card p-5">
                    <span class="text-2xl" aria-hidden="true">{v.icono}</span>
                    <h3 class="font-display font-bold text-sm text-ink mt-2">{v.t}</h3>
                    <p class="text-xs text-muted mt-1 leading-relaxed">{v.d}</p>
                  </div>
                ))
              }
            </div>

            <div class="flex flex-col sm:flex-row gap-3 mt-8">
              <a href="/register?tipo=persona" class="btn-primary px-6 py-3 text-sm">Únete a Adopty</a>
              <a href="/explorar" class="btn-ghost px-6 py-3 text-sm">Ver mascotas</a>
            </div>
          </div>

          <div class="soft-card p-6 sm:p-8">
            <h3 class="font-display font-extrabold text-xl text-ink">Nuestra misión en números</h3>
            <dl class="grid grid-cols-2 gap-4 mt-6">
              <div class="bg-surface rounded-2xl p-5 border border-line">
                <dd class="font-display font-extrabold text-3xl text-brand tabular">{conDb ? `${totalDisponibles}+` : '120+'}</dd>
                <dt class="text-xs text-muted font-semibold mt-1">Mascotas en adopción</dt>
              </div>
              <div class="bg-surface rounded-2xl p-5 border border-line">
                <dd class="font-display font-extrabold text-3xl text-teal tabular">+35</dd>
                <dt class="text-xs text-muted font-semibold mt-1">Refugios aliados</dt>
              </div>
              <div class="bg-surface rounded-2xl p-5 border border-line">
                <dd class="font-display font-extrabold text-3xl text-ink tabular">100%</dd>
                <dt class="text-xs text-muted font-semibold mt-1">Chat interno</dt>
              </div>
              <div class="bg-surface rounded-2xl p-5 border border-line">
                <dd class="font-display font-extrabold text-3xl text-ink tabular">0$</dd>
                <dt class="text-xs text-muted font-semibold mt-1">Comisión de Adopty</dt>
              </div>
            </dl>
            <p class="text-xs text-muted mt-6 leading-relaxed">
              Adopty es solo el canal de contacto: no cobra comisiones ni gestiona pagos. El acuerdo
              entre rescatista y adoptante (incluida cualquier cooperación económica) es ajeno a la
              plataforma.
            </p>
            <p class="text-xs text-faint mt-3 leading-relaxed">
              Proyecto académico · Facultad de Informática, Electrónica y Comunicación · Universidad de Panamá.
            </p>
          </div>
        </div>
      </section>
    )
  }

  <!-- El CTA final vive ahora dentro del pie (misma pantalla) -->
</Layout>

<style>
  /* Carrusel por pasos de mascotas destacadas.
     Muestra 4 tarjetas y da un salto (no deslizamiento continuo) cada pocos
     segundos. Sin JS queda como fila desplazable horizontalmente. */
  .carousel {
    position: relative;
    /* Tarjetas visibles por vista y separación (se ajustan por breakpoint) */
    --carr-per: 1.12;
    --carr-gap: 1rem;
  }
  .carousel-viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }
  /* Con JS activo el movimiento lo controla el carrusel: sin scroll manual */
  .carousel.is-listo .carousel-viewport {
    overflow: hidden;
  }
  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }
  /* El ancho se calcula para que quepan exactamente `--carr-per` tarjetas */
  .carousel-track {
    display: flex;
    width: 100%;
    gap: var(--carr-gap);
    transition: transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }
  .carousel-item {
    flex: 0 0 auto;
    width: calc((100% - (var(--carr-per) - 1) * var(--carr-gap)) / var(--carr-per));
  }
  @media (min-width: 640px) {
    .carousel {
      --carr-per: 2;
      --carr-gap: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .carousel {
      --carr-per: 4;
      --carr-gap: 1.5rem;
    }
  }

  /* Flechas a los extremos */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: #fff;
    border: 1px solid var(--color-line);
    box-shadow: 0 10px 24px rgb(30 41 59 / 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.7rem;
    line-height: 1;
    padding-bottom: 0.15rem;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .carousel-arrow:hover {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #fff;
  }
  .carousel-arrow:active {
    transform: translateY(-50%) scale(0.94);
  }
  .carousel-arrow--prev {
    left: 0.25rem;
  }
  .carousel-arrow--next {
    right: 0.25rem;
  }
  @media (min-width: 768px) {
    .carousel-arrow--prev {
      left: -1.25rem;
    }
    .carousel-arrow--next {
      right: -1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }
</style>

<script is:inline>
  // Carrusel por pasos: 4 tarjetas visibles, salto cada pocos segundos y
  // flechas a los extremos. La fila se clona al inicio para el bucle de vuelta.
  (() => {
    const root = document.getElementById('destacadasCarrusel');
    const track = document.getElementById('carrTrack');
    const prev = document.getElementById('carrPrev');
    const next = document.getElementById('carrNext');
    if (!root || !track || !prev || !next) return;
    const total = track.children.length;
    if (total < 2) return;

    // Copiamos las primeras tarjetas al final para poder saltar sin corte.
    const copias = Math.min(4, total);
    for (let i = 0; i < copias; i++) {
      const clon = track.children[i].cloneNode(true);
      clon.setAttribute('aria-hidden', 'true');
      clon.querySelectorAll('a, button, input').forEach((n) => n.setAttribute('tabindex', '-1'));
      track.appendChild(clon);
    }

    let index = 0;
    let stride = 0;
    const medir = () => {
      stride = track.children[1].offsetLeft - track.children[0].offsetLeft;
    };
    const aplicar = (animar) => {
      if (!animar) track.style.transition = 'none';
      track.style.transform = `translateX(${-index * stride}px)`;
      if (!animar) {
        void track.offsetWidth; // reflow: el próximo cambio sí anima
        track.style.transition = '';
      }
    };
    const ir = (i, animar = true) => {
      index = i;
      aplicar(animar);
    };
    const siguiente = () => ir(index + 1);
    const anterior = () => {
      if (index === 0) {
        ir(total, false); // posición equivalente al inicio (copia)
        requestAnimationFrame(() => requestAnimationFrame(() => ir(total - 1, true)));
      } else {
        ir(index - 1);
      }
    };

    // Al caer en la zona de copias, se vuelve sin animación al inicio real.
    track.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'transform' && index >= total) ir(0, false);
    });

    medir();
    aplicar(false);
    window.addEventListener('resize', () => {
      medir();
      aplicar(false);
    });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reanudable = () => !reduce && !document.hidden;
    let activo = reanudable();
    let reanudarTimer;

    // Se mantiene unos segundos en cada posición antes del siguiente salto.
    setInterval(() => {
      if (activo) siguiente();
    }, 4000);

    const pausar = () => {
      activo = false;
    };
    const reanudar = () => {
      activo = reanudable();
    };
    const reanudarMasTarde = () => {
      pausar();
      clearTimeout(reanudarTimer);
      reanudarTimer = setTimeout(reanudar, 8000);
    };

    root.addEventListener('mouseenter', pausar);
    root.addEventListener('mouseleave', reanudar);
    root.addEventListener('focusin', pausar);
    root.addEventListener('focusout', reanudar);
    document.addEventListener('visibilitychange', reanudar);
    prev.addEventListener('click', () => {
      anterior();
      reanudarMasTarde();
    });
    next.addEventListener('click', () => {
      siguiente();
      reanudarMasTarde();
    });

    root.classList.add('is-listo');
  })();

  // Logo del navbar: en la portada empieza oculto y aparece deslizándose desde
  // abajo al bajar; si volvemos a inicio, se desliza hacia abajo y desaparece.
  (() => {
    const navBrand = document.getElementById('navBrand');
    const heroLogo = document.getElementById('heroLogo');
    if (!navBrand || !heroLogo) return;

    const NAV_H = 80; // alto de la barra
    let showAt = 0;

    const measure = () => {
      const r = heroLogo.getBoundingClientRect();
      // Aparece cuando el logo del hero ya quedó detrás de la barra.
      showAt = Math.max(24, r.top + window.scrollY + r.height - NAV_H);
    };
    const update = () => {
      navBrand.classList.toggle('nav-brand--visible', window.scrollY > showAt);
    };

    measure();
    window.addEventListener('load', measure);
    window.addEventListener('resize', measure);
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();

  // Paginado suave: la rueda del ratón y las flechas mueven sección a sección
  // con la misma transición suave que los enlaces del navbar.
  (() => {
    const lg = window.matchMedia('(min-width: 1024px)');
    let positions = [];
    let hayAlta = false;
    let lock = false;
    let acc = 0;
    let lockTimer = 0;

    const medir = () => {
      const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 81;
      const targets = [].slice.call(
        document.querySelectorAll('html.snap-home .snap-sec, html.snap-home footer'),
      );
      positions = targets.map((el) =>
        Math.round(el.getBoundingClientRect().top + window.scrollY - pad),
      );
      // Si alguna sección es más alta que la ventana (pantallas bajas), no
      // interceptamos la rueda: se deja el scroll nativo para poder verla toda.
      hayAlta = targets.some((el) => el.offsetHeight > window.innerHeight - pad + 2);
    };

    const indiceActual = () => {
      const cur = window.scrollY;
      let idx = 0;
      let best = Infinity;
      for (let i = 0; i < positions.length; i++) {
        const d = Math.abs(positions[i] - cur);
        if (d < best) {
          best = d;
          idx = i;
        }
      }
      return idx;
    };

    const paso = (dir) => {
      if (lock || positions.length < 2) return;
      const idx = indiceActual();
      const next = Math.min(positions.length - 1, Math.max(0, idx + dir));
      if (next === idx) return;
      lock = true;
      window.scrollTo({ top: positions[next], behavior: 'smooth' });
      clearTimeout(lockTimer);
      lockTimer = window.setTimeout(() => {
        lock = false;
      }, 850);
    };

    document.documentElement.addEventListener(
      'wheel',
      (e) => {
        if (!lg.matches || positions.length < 2 || hayAlta) return;
        e.preventDefault();
        acc += e.deltaY;
        if (Math.abs(acc) < 30) return;
        const dir = acc > 0 ? 1 : -1;
        acc = 0;
        paso(dir);
      },
      { passive: false },
    );

    window.addEventListener('keydown', (e) => {
      if (!lg.matches || positions.length < 2 || hayAlta) return;
      const t = e.target;
      if (
        t &&
        (t.tagName === 'INPUT' ||
          t.tagName === 'SELECT' ||
          t.tagName === 'TEXTAREA' ||
          t.isContentEditable)
      ) {
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'PageDown' || (e.key === ' ' && !e.shiftKey)) {
        e.preventDefault();
        paso(1);
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp' || (e.key === ' ' && e.shiftKey)) {
        e.preventDefault();
        paso(-1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        window.scrollTo({ top: positions[0] || 0, behavior: 'smooth' });
      } else if (e.key === 'End') {
        e.preventDefault();
        window.scrollTo({ top: positions[positions.length - 1] || 0, behavior: 'smooth' });
      }
    });

    // Al terminar el desplazamiento suave se libera el bloqueo (con respaldo).
    window.addEventListener('scrollend', () => {
      lock = false;
    });

    medir();
    window.addEventListener('load', medir);
    window.addEventListener('resize', medir);
  })();

  // Scroll-spy: el subrayado del navbar sigue la sección visible de la portada.
  (() => {
    const enlaces = [].slice.call(
      document.querySelectorAll('.nav-link[href^="/#"], .nav-movil-link[href^="/#"]'),
    );
    if (!enlaces.length) return;
    const objetivos = ['#inicio', '#mascotas', '#como-funciona', '#nosotros', '#contacto']
      .map((h) => ({ h, el: document.getElementById(h.slice(1)) }))
      .filter((o) => o.el);

    const actualizar = () => {
      const ref = window.scrollY + 101; // un poco por debajo de la barra
      let actual = objetivos[0]?.h;
      for (const o of objetivos) {
        const top = o.el.getBoundingClientRect().top + window.scrollY;
        if (top <= ref) actual = o.h;
      }
      enlaces.forEach((a) => {
        if (a.getAttribute('href') === `/${actual}`) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
    };

    actualizar();
    window.addEventListener('load', actualizar);
    window.addEventListener('scroll', actualizar, { passive: true });
    window.addEventListener('resize', actualizar);
  })();
</script>
