---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PetCard from '../components/PetCard.astro';
import Badge from '../components/Badge.astro';
import { supabaseServer } from '../lib/supabase';
import { buscarMascotas, estadoLabel, edadLabel, fotoUrl, gradFor, type MascotaRow, type FotoRow } from '../lib/mascotas';
import { PETS } from '../data/mockPets';

type Card = {
  id: string;
  slug?: string;
  nombre: string;
  raza: string;
  sexo: string;
  tamano: string;
  ubicacion: string;
  estado: string;
  edadLabel: string;
  fotos: FotoRow[];
};

const deMock = (p: (typeof PETS)[number]): Card => ({
  id: p.id,
  slug: undefined,
  nombre: p.nombre,
  raza: p.raza,
  sexo: p.sexo,
  tamano: p.tamano,
  ubicacion: p.ubicacion,
  estado: p.estado === 'En proceso' ? 'en_proceso' : p.estado === 'Adoptada' ? 'adoptada' : 'disponible',
  edadLabel: p.edad,
  fotos: [{ id_mascota: p.id, url_foto: p.foto, es_principal: true, orden: 0 }],
});

// DB primero (Fase 3); si está vacía o falla, catálogo demo del Fase 0.
let destacadas: Card[] = [];
let hero: Card[] = [];
let conDb = false;
let totalDisponibles = 0;
try {
  const r = await buscarMascotas(supabaseServer(Astro.cookies), { estado: 'disponible', pageSize: 6 });
  destacadas = r.items.map((p: MascotaRow & { fotos: FotoRow[] }) => ({
    id: p.id,
    slug: p.slug,
    nombre: p.nombre,
    raza: p.raza,
    sexo: p.sexo,
    tamano: p.tamano,
    ubicacion: p.ubicacion,
    estado: p.estado,
    edadLabel: edadLabel(p.edad_meses),
    fotos: p.fotos,
  }));
  hero = destacadas.slice(0, 4);
  conDb = destacadas.length > 0;
  totalDisponibles = r.total;
} catch {
  conDb = false;
}
if (!conDb) {
  destacadas = PETS.filter((p) => p.estado === 'Disponible').slice(0, 6).map(deMock);
  hero = PETS.slice(0, 4).map(deMock);
  totalDisponibles = 120; // estimación del catálogo demo
}

const PASOS = [
  { n: '1', t: 'Explora con filtros', d: 'Especie, raza, edad, sexo, tamaño y ubicación. Sin necesidad de cuenta.' },
  { n: '2', t: 'Habla sin exponer tu número', d: 'Chat interno por cada mascota. Tus datos personales nunca se muestran.' },
  { n: '3', t: 'Solicita y sigue el estado', d: 'Pendiente → Aprobada → En proceso → Adoptada, visible en todo momento.' },
];
---

<Layout title="Adopty — Adopta con amor en Panamá">
  <Navbar active="inicio" />

  <header class="max-w-6xl mx-auto px-4 mt-6">
    <div class="soft-card overflow-hidden grid md:grid-cols-2" style="background:linear-gradient(120deg,#FFF8F1 60%,#E6FAF7)">
      <div class="p-7 sm:p-12">
        <div class="flex flex-wrap items-center gap-2">
          <Badge estado="Disponible" />
          <span class="text-xs font-bold text-muted">Adopción centralizada en Panamá</span>
        </div>
        <h1 class="font-display font-extrabold text-4xl sm:text-5xl leading-tight mt-3">
          Encuentra a tu<br />compañero <span class="text-brand">ideal</span>
        </h1>
        <p class="mt-4 text-[0.95rem] leading-relaxed">
          Deja los estados de WhatsApp. Busca por especie, edad y ubicación, habla por chat interno y solicita
          adopción sin exponer tu número.
        </p>
        <form
          action="/explorar"
          method="get"
          class="mt-6 flex flex-wrap gap-2 bg-white p-2 rounded-full border border-line"
          style="box-shadow:0 12px 36px rgb(30 41 59 / .12)"
        >
          <label class="sr-only" for="especie">Especie</label>
          <select id="especie" name="especie" class="chip border-0">
            <option value="">Todas</option>
            <option value="perro">Perro</option>
            <option value="gato">Gato</option>
            <option value="otro">Otro</option>
          </select>
          <label class="sr-only" for="q">Buscar</label>
          <input
            id="q"
            name="q"
            class="flex-1 min-w-[140px] px-3 bg-transparent outline-none text-sm"
            placeholder="Raza, ubicación... (ej. Bethania)"
          />
          <button class="btn-primary text-sm px-6 py-3" type="submit">Buscar</button>
        </form>
        <dl class="flex gap-6 mt-7 text-sm">
          <div>
            <dd class="font-display font-extrabold text-2xl text-ink tabular">{conDb ? `${totalDisponibles}+` : '120+'}</dd>
            <dt class="text-xs text-muted">Disponibles hoy</dt>
          </div>
          <div>
            <dd class="font-display font-extrabold text-2xl text-ink tabular">{conDb ? '✓' : '15'}</dd>
            <dt class="text-xs text-muted">Refugios verificados</dt>
          </div>
          <div>
            <dd class="font-display font-extrabold text-2xl text-ink tabular">0$</dd>
            <dt class="text-xs text-muted">Costo para adoptar</dt>
          </div>
        </dl>
      </div>

      {/* Mosaico de mascotas: enlace completo a la ficha en cada tarjeta */}
      <div class="relative p-6 pt-0 md:pt-6 grid grid-cols-2 gap-3 self-center">
        {
          hero.map((p) => {
            const foto = fotoUrl(p.fotos[0]?.url_foto);
            const href = p.slug ? `/mascota/${p.slug}` : `/mascota/${p.id}`;
            return (
              <a
                href={href}
                class="soft-card overflow-hidden block card-link group"
                aria-label={`Ver perfil de ${p.nombre}`}
              >
                <div class={`pet-photo ${gradFor(p.id)} w-full h-32 sm:h-36`}>
                  {foto && (
                    <img
                      src={foto}
                      alt={p.nombre}
                      loading="lazy"
                      decoding="async"
                      width="400"
                      height="300"
                      class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      onerror="this.remove()"
                    />
                  )}
                </div>
                <div class="p-3 flex items-center justify-between gap-2">
                  <b class="text-sm text-ink truncate">{p.nombre}</b>
                  <Badge estado={estadoLabel(p.estado)} />
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </header>

  <section class="max-w-6xl mx-auto px-4 mt-10" aria-labelledby="sec-destacadas">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 id="sec-destacadas" class="font-display font-extrabold text-2xl">Mascotas destacadas</h2>
        <p class="text-sm text-muted">Disponibles ahora mismo cerca de ti</p>
      </div>
      <a href="/explorar" class="link link-suave text-sm whitespace-nowrap">Ver todas →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-5">
      {destacadas.map((p) => <PetCard {...p} />)}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 mt-12 grid md:grid-cols-3 gap-5" aria-label="Cómo funciona">
    {
      PASOS.map((p) => (
        <div class="soft-card p-6 card-link">
          <span class="avatar w-9 h-9 text-sm" aria-hidden="true">
            {p.n}
          </span>
          <h3 class="font-display font-bold mt-3">{p.t}</h3>
          <p class="text-sm mt-1 text-muted">{p.d}</p>
        </div>
      ))
    }
  </section>
</Layout>